#!/usr/bin/env bash
set -euo pipefail

# Banned-construct scan (Spec 14.2 item 2, 5.6, 14.2 item 7).
#
# Usage: crrg-banned [dir-or-file ...]     (default: the CRRG core library)
#
# Complements crrg-audit: the axiom audit catches holes that reach the kernel,
# this catches escape hatches that keep a declaration axiom-clean while
# defeating the trust model, plus any aggregate progress magnitude.

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CRRG_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "${CRRG_WORKDIR:-$CRRG_ROOT}"

exec python "$SCRIPT_DIR/banned_scan.py" "$@"
