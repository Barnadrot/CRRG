#!/usr/bin/env python3
"""Append-only research episode log (Spec §22, §23).

Usage:
    crrg-episode [--threshold N] open       <log> <episode_id> <obligation_id>
                                            <mechanism_id> <start_ref> [note]
                                            [--mode normal|novelty]
    crrg-episode [--threshold N] checkpoint <log> <episode_id> <ref> [note]
    crrg-episode [--threshold N] terminal   <log> <episode_id> <outcome> [note]
    crrg-episode [--threshold N] apply      <log> <episode_id> <effect> [note]
    crrg-episode [--threshold N] respond    <log> <obligation_id> <response> [note]
    crrg-episode [--threshold N] status     <log> [obligation_id]
    crrg-episode [--threshold N] may-launch <log> <obligation_id> <mechanism_id>
    crrg-episode [--threshold N] validate   <log>

The log is TSV with eight fixed columns, `-` for an empty field, `#` comment
lines allowed:

    kind  episode_id  obligation_id  mechanism_id  payload  commit  created  note

An episode (§23) is: one exact obligation, one certified start state, one
mechanism, zero or more checkpoints, exactly one terminal outcome. A checkpoint
is append-only research evidence -- it does not mutate the graph, does not
increment the stall detector, and does not close the episode.

WHY THE WHOLE LOG IS VALIDATED ON EVERY INVOCATION
--------------------------------------------------
The rules that matter here are sequential -- "the episode is open", "the
obligation is blocked", "exactly one terminal" -- so they are properties of the
log as a history, not of the row being written. Checking only the new row would
let an already-broken log keep accepting rows and quietly become the record of
record. So every invocation replays the entire file first; any violation
anywhere fails the invocation before anything is appended, and the file is left
byte-identical on every failing path (verified, not asserted).

The log is append-only. Nothing here rewrites or deletes a row: existing git
history and existing rows remain valid evidence (§23), and orchestration
semantics are forward-only.

THE STALL REPLAY MIRRORS CRRG/Stall.lean
----------------------------------------
`CRRG/CRRG/Stall.lean` is the semantic reference; this is a mirror of it, not a
second opinion. Per obligation, in log order:

    TERMINAL admitted-*            count := 0, unblocked
    TERMINAL noTransition          count := count + 1
                                   blocked := blocked OR (count % threshold == 0)
    TERMINAL rejected|toolingFailure   nothing
    CHECKPOINT                     nothing
    RESPONSE                       unblocked

Note the OR: a block accumulates, it is never assigned. Only a recorded stall
response or certified movement clears one (§22). Were the flag assigned, a sixth
no-transition would compute 6 % 5 != 0 and clear the block -- an obligation
would escape its own stall by producing exactly the no-movement the detector
exists to interrupt.

WHAT THIS DOES NOT DO
---------------------
It does not judge whether an obligation is true, hard, or at the right depth
(§10 is a separate judgement), and it does not decide what to research next. The
count is orchestration state: it never feeds a score, a reward, or a rendered
aggregate (§1, §19.3). `status` prints labeled state and nothing that could be
read as a result.

The same-mechanism rejection is deliberately *immediate only*: it fires against
the next launch after a stall response, and is spent by that launch. Durable
anti-circling across a long history is deferred research (§26 R2), not something
this script pretends to enforce.

`open` and `may-launch` consult one guard (`launch_refusal`): `may-launch`
reports it, `open` enforces it. Opening an episode is launching research, so a
blocked obligation, or the mechanism that stalled it, is refused at `open` rather
than merely reported to a caller who is free to ignore the answer.

WHAT COUNTS AS A REASON TO STOP (§29.1)
---------------------------------------
A `noTransition` is not one, which is why `terminal` renders §30's persistence
block on it. An exact OPEN obligation is an active research mandate: lack of a
known technique is a description of the research problem, not a blocker, and a
stall changes HOW the system researches rather than authorising it to stop.

A run may stop or pause only for these objective conditions:

    OPERATOR_STOP        authenticated operator instruction
    TOOLING_BLOCKED      required compiler / repository / execution facility
                         unavailable after the deployment's defined
                         retry/recovery policy
    NO_ADMISSIBLE_WORK   no OPEN schedulable obligation remains under the
                         certified graph and operator policy
    PROGRAM_COMPLETE     the project's terminal condition reached and no
                         automatic next target admissible

A certified closure, refutation, retirement, split or supersession is a state
TRANSITION, not a reason to stop. **There is no generic `RESEARCH_BLOCKED`
escape hatch**, and this script provides no way to record one: a deployment that
finds itself wanting one has an underspecified programme, not a blocker. That is
documentation of the contract, not a check this tool enforces — the enforcement
lives in the programme and the gate.
"""

import argparse
import hashlib
import os
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

KINDS = ("OPEN", "CHECKPOINT", "TERMINAL", "RESPONSE", "APPLY", "REFUSED_LAUNCH")

OUTCOMES = (
    # §32/D.2: the adjudication-level token. `admitted` says the adjudication
    # admitted a certified transition, and nothing about which effects were
    # committed -- that is what APPLY rows carry. The `admitted-<kind>` tokens
    # below stay VALID for historical rows (§35 is forward-only); replay treats
    # every one of them as admitted.
    "admitted",
    "admitted-closed",
    "admitted-refined",
    "admitted-split",
    "admitted-refuted",
    "admitted-retired",
    "admitted-superseded",
    "admitted-quantitative",
    "noTransition",
    "rejected",
    "toolingFailure",
)

# §32: the certified effects an APPLY row may record -- §19.1's kinds, at the
# effect level rather than the adjudication level.
EFFECTS = (
    "closed",
    "refined",
    "split",
    "refuted",
    "retired",
    "superseded",
    "quantitative",
)

# §33.2: why a launch was refused. The class, not the prose -- the message is for
# a human, this is for an auditor asking which enforcement fired.
REFUSAL_CLASSES = ("blocked", "armed-same-mechanism", "novelty-required")

RESPONSES = (
    "reselect",
    "backtrack",
    "newMechanism",
    "proposeRefinement",
    "ownerOverride",
)

# §19.2: the four terminal states must stay mechanically distinguishable.
OUTCOME_EXIT = {"noTransition": 10, "rejected": 20, "toolingFailure": 30}

# §30: what a valid no-transition says to the researcher.
#
# Exit 10 and the two-axis semantics (§19) are unchanged; what changes is the
# RENDERING. `guidance: CONTINUE_RESEARCH` is the machine-readable marker a
# research loop keys on; the lines under it are §30's text verbatim, and are spec
# text rather than this script's prose -- do not reword them here.
#
# Printed only for `noTransition`. An admitted transition, a rejection and a
# tooling failure each say something different and none of them is this.
PERSISTENCE_BLOCK = """guidance: CONTINUE_RESEARCH
NO_TRANSITION
The exact certified obligation remains OPEN.
No certified blocker has been established.
CRRG has accepted no state movement.
The absence of a known proof technique is the research problem,
not a stopping condition.
Continue mathematical research on an admissible OPEN obligation."""

NCOL = 8
COLUMNS = "kind episode_id obligation_id mechanism_id payload commit created note".split()

EXIT_OK = 0
EXIT_REJECT = 20
EXIT_MALFORMED = 30

DEFAULT_THRESHOLD = 5

# §31.1's deployment default: three completed stall cycles since the last
# admitted transition put an obligation in NOVELTY_REQUIRED. Mirrors
# CRRG.Novelty.defaultCycleThreshold. Downstream-configurable is a Phase F
# concern; there is no flag for it here.
DEFAULT_CYCLE_THRESHOLD = 3


class Malformed(Exception):
    """The log is not a well-formed episode log (exit 30)."""


class Violation(Exception):
    """The log breaks a §22/§23 rule (exit 30)."""


class Row:
    __slots__ = ("lineno", "kind", "episode_id", "obligation_id", "mechanism_id",
                 "payload", "commit", "created", "note")

    def __init__(self, lineno, fields):
        self.lineno = lineno
        (self.kind, self.episode_id, self.obligation_id, self.mechanism_id,
         self.payload, self.commit, self.created, self.note) = fields


def read_rows(path: Path):
    """Parse the whole log. Raises Malformed; never partially succeeds."""
    if not path.is_file():
        raise Malformed(f"no episode log at {path}")
    rows = []
    for lineno, line in enumerate(path.read_text().splitlines(), start=1):
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        fields = line.split("\t")
        if len(fields) != NCOL:
            raise Malformed(
                f"line {lineno}: wrong column count ({len(fields)}, expected {NCOL}). "
                f"Columns are: {'  '.join(COLUMNS)}"
            )
        if fields[0] not in KINDS:
            raise Malformed(
                f"line {lineno}: unknown kind {fields[0]!r}; expected one of "
                + " | ".join(KINDS)
            )
        rows.append(Row(lineno, fields))
    return rows


def is_admitted(outcome: str) -> bool:
    """Did this terminal admit a certified transition?

    One predicate for both spellings: D.2's adjudication-level `admitted` and the
    legacy `admitted-<kind>` tokens, which stay valid for historical rows under
    §35's forward-only rule. Everything that asks "was this admitted?" asks here,
    so the two spellings cannot drift apart.
    """
    return outcome == "admitted" or outcome.startswith("admitted-")


def is_multiple(count: int, threshold: int) -> bool:
    """Mirrors Lean `Nat` semantics, where `n % 0 = n`, so a threshold of 0
    never blocks for the count >= 1 reachable here."""
    if threshold <= 0:
        return count == 0
    return count % threshold == 0


def new_obligation_state():
    return {
        "count": 0,
        "blocked": False,
        "open_episode": None,
        # Mechanism of the episode whose no-transition flipped `blocked` to true.
        "pending_trigger": None,
        # Mechanism a launch is currently refused for; spent by the next OPEN.
        "armed": None,
        # §31's second order: completed stall cycles since the last admitted
        # transition. A cycle is a block event followed by its recorded
        # response, so this is incremented by `apply_response` -- which the
        # replay reaches only for a response recorded WHILE BLOCKED, because
        # rule 4 rejects any other. That is the coupling CRRG.Novelty
        # deliberately leaves to the deployment; this is the deployment.
        "cycles": 0,
    }


def replay(rows, threshold: int):
    """Validate rules 1-5 over the whole log and return per-obligation state.

    Raises Violation (rule break) or Malformed (unknown token / shape).
    """
    episodes = {}
    obligations = {}

    def ostate(oid):
        return obligations.setdefault(oid, new_obligation_state())

    for r in rows:
        if r.kind == "OPEN":
            if r.episode_id == "-":
                raise Malformed(f"line {r.lineno}: an OPEN row needs a real episode_id")
            if r.episode_id in episodes:
                raise Violation(
                    f"line {r.lineno}: episode id {r.episode_id!r} already used at line "
                    f"{episodes[r.episode_id]['lineno']}. Episode ids are not reused."
                )
            st = ostate(r.obligation_id)
            if st["open_episode"] is not None:
                raise Violation(
                    f"line {r.lineno}: obligation {r.obligation_id!r} already has an "
                    f"open episode ({st['open_episode']!r}). One episode at a time per "
                    "obligation (§23)."
                )
            episodes[r.episode_id] = {
                "lineno": r.lineno,
                "obligation": r.obligation_id,
                "mechanism": r.mechanism_id,
                "closed": False,
                # Set when the episode closes; APPLY rows are legal only after an
                # admitted one (§32).
                "admitted": False,
                # The state this episode opened from -- the lower bound of the
                # commit range checkpoint derivation walks (§33.1).
                "commit": r.commit,
            }
            st["open_episode"] = r.episode_id
            # A launch happened: an armed same-mechanism rejection is spent.
            st["armed"] = None

        elif r.kind in ("CHECKPOINT", "TERMINAL"):
            ep = episodes.get(r.episode_id)
            if ep is None:
                raise Violation(
                    f"line {r.lineno}: no OPEN row for episode {r.episode_id!r}"
                )
            if ep["closed"]:
                raise Violation(
                    f"line {r.lineno}: episode {r.episode_id!r} is closed; no row may "
                    "reference a closed episode, and an episode has exactly one "
                    "terminal outcome (§23)."
                )
            if r.obligation_id != ep["obligation"]:
                raise Violation(
                    f"line {r.lineno}: obligation mismatch for episode "
                    f"{r.episode_id!r}: row says {r.obligation_id!r}, its OPEN says "
                    f"{ep['obligation']!r}"
                )
            if r.mechanism_id != ep["mechanism"]:
                raise Violation(
                    f"line {r.lineno}: mechanism mismatch for episode "
                    f"{r.episode_id!r}: row says {r.mechanism_id!r}, its OPEN says "
                    f"{ep['mechanism']!r}"
                )
            st = ostate(r.obligation_id)
            if r.kind == "TERMINAL":
                if r.payload not in OUTCOMES:
                    raise Malformed(
                        f"line {r.lineno}: unknown outcome token {r.payload!r}; "
                        "expected one of " + " | ".join(OUTCOMES)
                    )
                ep["closed"] = True
                ep["admitted"] = is_admitted(r.payload)
                st["open_episode"] = None
                apply_terminal(st, r.payload, ep["mechanism"], threshold)

        elif r.kind == "APPLY":
            # §32: bookkeeping for effects committed AFTER an admitted
            # adjudication. It never opens an episode, and the counters below
            # never see it -- the stall detector and the cycle counter read the
            # adjudication axis only, so an apply event must not be able to move
            # either. That is why this branch touches no obligation state at all.
            ep = episodes.get(r.episode_id)
            if ep is None:
                raise Violation(
                    f"line {r.lineno}: no OPEN row for episode {r.episode_id!r}"
                )
            if r.payload not in EFFECTS:
                raise Malformed(
                    f"line {r.lineno}: unknown effect {r.payload!r}; expected one of "
                    + " | ".join(EFFECTS)
                )
            if r.obligation_id != ep["obligation"]:
                raise Violation(
                    f"line {r.lineno}: obligation mismatch for episode "
                    f"{r.episode_id!r}: row says {r.obligation_id!r}, its OPEN says "
                    f"{ep['obligation']!r}"
                )
            if not ep["closed"]:
                raise Violation(
                    f"line {r.lineno}: episode {r.episode_id!r} is still open. An "
                    "apply event records effects committed after an adjudication, "
                    "so it follows the terminal row rather than preceding it (§32)."
                )
            if not ep["admitted"]:
                raise Violation(
                    f"line {r.lineno}: episode {r.episode_id!r} did not admit a "
                    "certified transition, so there is no certified effect to "
                    "record. An apply event on a noTransition, rejected or "
                    "toolingFailure episode would claim state movement the "
                    "adjudication refused (§32)."
                )

        elif r.kind == "REFUSED_LAUNCH":
            # §33.2: enforcement that fires must be distinguishable from
            # enforcement that never fires. The row is the audit trace and
            # nothing else -- it opens no episode, produces no outcome, and
            # increments no counter, so it is validated for shape and then
            # deliberately ignored.
            if r.episode_id != "-":
                raise Malformed(
                    f"line {r.lineno}: a REFUSED_LAUNCH row carries episode_id '-'; "
                    "a refused launch opened no episode"
                )
            if r.payload not in REFUSAL_CLASSES:
                raise Malformed(
                    f"line {r.lineno}: unknown refusal class {r.payload!r}; expected "
                    "one of " + " | ".join(REFUSAL_CLASSES)
                )

        elif r.kind == "RESPONSE":
            if r.episode_id != "-" or r.mechanism_id != "-":
                raise Malformed(
                    f"line {r.lineno}: a RESPONSE row carries episode_id '-' and "
                    "mechanism_id '-'; it is recorded against the obligation, not an "
                    "episode"
                )
            if r.payload not in RESPONSES:
                raise Malformed(
                    f"line {r.lineno}: unknown response name {r.payload!r}; expected "
                    "one of " + " | ".join(RESPONSES)
                )
            st = ostate(r.obligation_id)
            if not st["blocked"]:
                raise Violation(
                    f"line {r.lineno}: obligation {r.obligation_id!r} is not blocked; "
                    "a stall response is only recorded against a blocked obligation "
                    "(§22)."
                )
            apply_response(st, r.payload)

    return obligations


def apply_terminal(st, outcome: str, mechanism: str, threshold: int) -> None:
    """The Stall.lean transition, per obligation."""
    if is_admitted(outcome):
        # Certified movement materially changed the obligation: the history of
        # no-transitions is spent, and so is any armed rejection.
        st["count"] = 0
        st["blocked"] = False
        st["pending_trigger"] = None
        st["armed"] = None
        # §31.4: the second order resets on the same event, by the same rule.
        # Mirrors CRRG.Novelty.CycleState.admittedReset.
        st["cycles"] = 0
    elif outcome == "noTransition":
        st["count"] += 1
        was_blocked = st["blocked"]
        if is_multiple(st["count"], threshold):
            # Accumulate, never assign.
            st["blocked"] = True
            if not was_blocked:
                st["pending_trigger"] = mechanism
    # `rejected` and `toolingFailure` are integrity events (§19): inert here.


def apply_response(st, response: str) -> None:
    st["blocked"] = False
    # A block event followed by its recorded response IS one completed cycle
    # (§31.1). The replay only gets here for a response recorded while blocked,
    # so reaching this line is exactly the condition. Mirrors
    # CRRG.Novelty.CycleState.completeCycle.
    st["cycles"] += 1
    if response != "ownerOverride" and st["pending_trigger"] is not None:
        # The first response that is not an owner override arms an immediate
        # rejection against the mechanism that stalled.
        st["armed"] = st["pending_trigger"]
        st["pending_trigger"] = None


# --------------------------------------------------------------------------
# Field hygiene
# --------------------------------------------------------------------------

def clean_note(note: str) -> str:
    """Tabs would add columns; newlines would add rows."""
    note = note.replace("\t", " ").replace("\r", " ").replace("\n", " ").strip()
    return note or "-"


def check_field(name: str, value: str) -> str:
    if value == "":
        raise Malformed(f"{name} is empty; use '-' for an intentionally empty field")
    if "\t" in value or "\n" in value or "\r" in value:
        raise Malformed(f"{name} may not contain a tab or newline")
    return value


def check_id(name: str, value: str) -> str:
    check_field(name, value)
    if any(c.isspace() for c in value) or value.startswith("#"):
        raise Malformed(
            f"{name} {value!r} must not contain whitespace or start with '#'"
        )
    return value


def head_commit() -> str:
    workdir = os.environ.get("CRRG_WORKDIR") or str(Path(__file__).resolve().parent.parent)
    try:
        out = subprocess.run(
            ["git", "-C", workdir, "rev-parse", "--short", "HEAD"],
            capture_output=True, text=True, check=True,
        )
        return out.stdout.strip() or "-"
    except (subprocess.CalledProcessError, FileNotFoundError):
        return "-"


def now_utc() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


# --------------------------------------------------------------------------
# Append, with the registry discipline of crrg-register-candidate
# --------------------------------------------------------------------------

def digest(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def append_rows(path: Path, rows_out, before: str) -> None:
    """Append one or more rows: build beside the real file, verify, rename over.

    Plural because `terminal` appends the episode's derived checkpoints and its
    terminal row in ONE invocation (§33.1). They go in a single atomic replace so
    a failure part-way through cannot leave an episode with checkpoints and no
    terminal -- the log would then say the episode is still open.

    A half-written log is never observable, and existing rows are compared rather
    than trusted -- that catches an editor, a locale, or a stray CR that a blind
    append would not.
    """
    original = path.read_text()
    prefix = original if (not original or original.endswith("\n")) else original + "\n"
    new_text = prefix + "".join("\t".join(f) + "\n" for f in rows_out)

    tmp = path.with_name(f"{path.name}.new.{os.getpid()}")
    try:
        tmp.write_text(new_text)
        if not tmp.read_text().startswith(original.rstrip("\n")):
            raise Malformed("appending would have altered an existing row")
        if digest(path) != before:
            raise Malformed("the log changed underneath this invocation")
        os.replace(tmp, path)
    finally:
        if tmp.exists():
            tmp.unlink()


# --------------------------------------------------------------------------
# Subcommands
# --------------------------------------------------------------------------

def cmd_validate(args, rows, _obligations) -> int:
    print("=== CRRG episode log validation ===")
    print(f"log        {args.log}")
    print(f"threshold  {args.threshold}")
    print(f"rows       {len(rows)}")
    print("")
    print("episode log OK")
    return EXIT_OK


def novelty_required(st) -> bool:
    """§31.1: at or past the cycle threshold since the last admitted transition.

    Mirrors CRRG.Novelty.CycleState.required — a threshold, not a multiple. The
    first-order block fires on every multiple of its threshold; this one, once
    reached, stays until an admitted transition resets it.
    """
    return DEFAULT_CYCLE_THRESHOLD <= st["cycles"]


def obligation_mode(st) -> str:
    """NORMAL | STALLED | NOVELTY_REQUIRED.

    STALLED WINS over NOVELTY_REQUIRED when both hold, and the order is the
    point: a blocked obligation is answered by recording a response, not by
    declaring a mode. Showing NOVELTY_REQUIRED to a researcher who first has to
    respond would name the wrong next action.
    """
    if st["blocked"]:
        return "STALLED"
    if novelty_required(st):
        return "NOVELTY_REQUIRED"
    return "NORMAL"


def print_obligation(oid: str, st) -> None:
    print(f"obligation {oid}")
    print(f"  no-transition-count: {st['count']}")
    print(f"  blocked: {'yes' if st['blocked'] else 'no'}")
    print(f"  open-episode: {st['open_episode'] or '-'}")
    print(f"  armed-mechanism: {st['armed'] or '-'}")
    print(f"  cycles: {st['cycles']}")
    print(f"  mode: {obligation_mode(st)}")


def cmd_status(args, _rows, obligations) -> int:
    print("=== CRRG episode status ===")
    print(f"log        {args.log}")
    print(f"threshold  {args.threshold}")
    print("")
    print("Orchestration state only. This is not a research result and carries no")
    print("judgement about truth, difficulty, or reduction depth (§10, §19.3).")
    print("")
    if args.obligation_id:
        st = obligations.get(args.obligation_id)
        if st is None:
            print(f"obligation {args.obligation_id}")
            print("  no rows in this log")
            return EXIT_OK
        print_obligation(args.obligation_id, st)
        return EXIT_OK
    for oid in sorted(obligations):
        print_obligation(oid, obligations[oid])
        print("")
    return EXIT_OK


def launch_refusal(st, obligation_id: str, mechanism_id: str, threshold: int,
                   novelty_mode: bool = False):
    """The §22 and §31.4 launch guard.

    Returns `(reason_class, message)` or None to permit. The CLASS is what a
    `REFUSED_LAUNCH` row records (§33.2) and the message is what a human reads;
    they come from one place so a refusal cannot be logged under one reason and
    explained by another.

    ONE implementation, shared by `may-launch` (which reports it) and `open`
    (which enforces it). A guard that answers one way when asked and another way
    when acted on is not a guard, and §31.4 puts its enforcement at the same
    point as §22's, so it belongs here rather than in a second check beside it.

    `novelty_mode` defaults False, which is what `may-launch` asks with: it is a
    query about the obligation, and a caller that has not declared novelty mode
    gets the answer for a normal-mode launch.
    """
    if st["blocked"]:
        return ("blocked", (
            f"stalled: response required for obligation {obligation_id!r} "
            f"(no-transition count {st['count']}, threshold {threshold}). "
            "Record one of: " + " | ".join(RESPONSES)
        ))
    if st["armed"] is not None and st["armed"] == mechanism_id:
        return ("armed-same-mechanism", (
            f"same mechanism immediately after stall: {mechanism_id!r} is the "
            f"mechanism that stalled obligation {obligation_id!r}. Continue under a "
            "different recorded mechanism, or record an ownerOverride (§22)."
        ))
    # §31.4, checked after the first-order refusals on purpose: while an
    # obligation is blocked the required action is a response, and naming the
    # mode instead would send the researcher to the wrong one. Mirrors
    # CRRG.Novelty.CycleState.modeAllowed.
    if novelty_required(st) and not novelty_mode:
        return ("novelty-required", (
            f"NOVELTY_REQUIRED: obligation {obligation_id!r} has completed "
            f"{st['cycles']} stall cycles since its last admitted transition "
            f"(threshold {DEFAULT_CYCLE_THRESHOLD}), so repeated attempts under "
            "recorded mechanisms have not produced certified movement. Open in "
            "novelty mode -- `--mode novelty` -- and invent mathematics capable "
            "of attacking the exact obligation (§31.3). This is not an "
            "escalation and not a stop: it changes the mode of research, not "
            "its continuation (§31.2)."
        ))
    return None


def cmd_may_launch(args, _rows, obligations) -> int:
    st = obligations.get(args.obligation_id) or new_obligation_state()
    refusal = launch_refusal(st, args.obligation_id, args.mechanism_id, args.threshold)
    if refusal is not None:
        # A pure query: it reports the guard's answer and writes nothing. Only
        # `open`, which actually attempts a launch, leaves a REFUSED_LAUNCH trace.
        print(f"MAY-LAUNCH REJECTED: {refusal[1]}", file=sys.stderr)
        return EXIT_REJECT
    print(f"may-launch: allowed  obligation {args.obligation_id}  mechanism {args.mechanism_id}")
    return EXIT_OK


def cmd_open(args, _rows, obligations, before: str):
    check_id("episode_id", args.episode_id)
    check_id("obligation_id", args.obligation_id)
    check_id("mechanism_id", args.mechanism_id)
    check_field("start_ref", args.start_ref)

    # §22: "a stall response is mandatory before another research episode may
    # launch on that obligation." Opening an episode IS launching research, so
    # the guard `may-launch` reports is enforced here rather than left advisory.
    #
    # There is deliberately no override flag. The override path is the already
    # recorded `ownerOverride` RESPONSE, which unblocks without arming, so an
    # override is a row in the append-only log that an auditor can see -- not a
    # command-line argument that leaves no trace.
    st = obligations.get(args.obligation_id) or new_obligation_state()
    novelty = args.mode == "novelty"
    refusal = launch_refusal(st, args.obligation_id, args.mechanism_id, args.threshold,
                             novelty_mode=novelty)
    if refusal is not None:
        reason_class, message = refusal
        # §33.2: THE REFUSAL IS THE RECORD. Every other failing path in this
        # script leaves the log byte-identical; this one deliberately does not,
        # because enforcement that fires has to be distinguishable from
        # enforcement that never fires, and a refusal that leaves no trace is
        # indistinguishable from a launch that never happened.
        #
        # The row opens nothing and counts nothing -- the replay validates its
        # shape and then ignores it.
        row = ["REFUSED_LAUNCH", "-", args.obligation_id, args.mechanism_id,
               reason_class, head_commit(), now_utc(), clean_note(args.note)]
        try:
            append_rows(Path(args.log), [row], before)
        except Malformed as e:
            print(f"EPISODE LOG MALFORMED: {e}", file=sys.stderr)
            sys.exit(EXIT_MALFORMED)
        print("appended:")
        print("  " + "\t".join(row))
        print(f"recorded: REFUSED_LAUNCH {reason_class} on obligation "
              f"{args.obligation_id}")
        print(f"EPISODE OPEN REJECTED: {message}", file=sys.stderr)
        sys.exit(EXIT_REJECT)

    # Audit evidence that this episode was opened in novelty mode, recorded in
    # the note field -- a value in a column that already exists, not a schema
    # change. Without it "the researcher declared novelty mode" would be a claim
    # with nothing behind it in the append-only log.
    note = clean_note(args.note)
    if novelty:
        note = "mode=novelty" if note == "-" else f"mode=novelty {note}"

    return ["OPEN", args.episode_id, args.obligation_id, args.mechanism_id,
            args.start_ref, head_commit(), now_utc(), note]


def episode_row(rows, episode_id: str):
    for r in rows:
        if r.kind == "OPEN" and r.episode_id == episode_id:
            return r
    raise Violation(
        f"no open episode {episode_id!r} in this log; a checkpoint or terminal is "
        "recorded against an episode that was opened (§23)."
    )


def cmd_checkpoint(args, rows, _obligations, before: str):
    check_id("episode_id", args.episode_id)
    check_field("ref", args.ref)
    ep = episode_row(rows, args.episode_id)
    return ["CHECKPOINT", args.episode_id, ep.obligation_id, ep.mechanism_id,
            args.ref, head_commit(), now_utc(), clean_note(args.note)]


def derive_checkpoints(rows, ep, episode_id: str):
    """§33.1: the branch's own history since the episode opened, as CHECKPOINT rows.

    Voluntary checkpointing failed in live operation -- three days, zero rows,
    while the research evidence landed as ordinary git commits. So the record is
    derived rather than asked for: every commit in `(open_commit, HEAD]` that is
    not already a CHECKPOINT row for this episode becomes one.

    Dedup is by commit SHA, which is what makes a re-run idempotent: closing the
    same episode twice cannot double-record its history.

    Derivation failure -- no git, an unreachable open commit -- is exit 30 with
    nothing appended. It is NOT silently skipped: a deployment that wants git to
    be the authoritative checkpoint history declares that as a programme
    decision (§33.1), and a runtime fallback would make the two cases
    indistinguishable.
    """
    workdir = os.environ.get("CRRG_WORKDIR") or str(Path(__file__).resolve().parent.parent)
    open_commit = ep["commit"]
    if not open_commit or open_commit == "-":
        raise Malformed(
            f"episode {episode_id!r} records no opening commit, so its checkpoint "
            "range has no lower bound (§33.1). Nothing was appended."
        )

    already = {r.payload for r in rows
               if r.kind == "CHECKPOINT" and r.episode_id == episode_id}

    try:
        proc = subprocess.run(
            ["git", "-C", workdir, "log", "--format=%H%x09%s",
             f"{open_commit}..HEAD"],
            capture_output=True, text=True, check=True,
        )
    except (subprocess.CalledProcessError, FileNotFoundError) as e:
        detail = getattr(e, "stderr", "") or str(e)
        raise Malformed(
            f"could not derive checkpoints for episode {episode_id!r} from "
            f"{open_commit}..HEAD in {workdir}: {detail.strip()}. Nothing was "
            "appended. §33.1 makes this a failure rather than a skip: a "
            "deployment that wants git to be the authoritative checkpoint history "
            "declares that, it does not fall back into it."
        ) from None

    out = []
    # git log is newest-first; the log should read in the order the work happened.
    for line in reversed(proc.stdout.splitlines()):
        if not line.strip():
            continue
        sha, _, subject = line.partition("\t")
        if sha in already:
            continue
        out.append(["CHECKPOINT", episode_id, ep["obligation"], ep["mechanism"],
                    sha, head_commit(), now_utc(), clean_note(subject)])
    return out


def cmd_apply(args, rows, _obligations, before: str):
    check_id("episode_id", args.episode_id)
    if args.effect not in EFFECTS:
        raise Malformed(
            f"unknown effect {args.effect!r}; expected one of " + " | ".join(EFFECTS)
        )
    ep = episode_row(rows, args.episode_id)
    return [["APPLY", args.episode_id, ep.obligation_id, ep.mechanism_id,
             args.effect, head_commit(), now_utc(), clean_note(args.note)]]


def cmd_terminal(args, rows, _obligations, before: str):
    check_id("episode_id", args.episode_id)
    if args.outcome not in OUTCOMES:
        raise Malformed(
            f"unknown outcome token {args.outcome!r}; expected one of "
            + " | ".join(OUTCOMES)
        )
    ep = episode_row(rows, args.episode_id)
    # §33.1: the episode's derived history goes in FIRST, so the log reads
    # open -> checkpoints -> terminal rather than recording the close before the
    # work it closes over.
    derived = derive_checkpoints(
        rows,
        {"commit": ep.commit, "obligation": ep.obligation_id,
         "mechanism": ep.mechanism_id},
        args.episode_id,
    )
    return derived + [["TERMINAL", args.episode_id, ep.obligation_id,
                       ep.mechanism_id, args.outcome, head_commit(), now_utc(),
                       clean_note(args.note)]]


def cmd_respond(args, _rows, obligations, before: str):
    check_id("obligation_id", args.obligation_id)
    if args.response not in RESPONSES:
        raise Malformed(
            f"unknown response name {args.response!r}; expected one of "
            + " | ".join(RESPONSES)
        )
    st = obligations.get(args.obligation_id) or new_obligation_state()
    if not st["blocked"]:
        print(
            f"RESPONSE REJECTED: obligation {args.obligation_id!r} is not blocked; a "
            "stall response is only recorded against a blocked obligation (§22). "
            f"No-transition count is {st['count']}, threshold {args.threshold}.",
            file=sys.stderr,
        )
        sys.exit(EXIT_REJECT)
    return ["RESPONSE", "-", args.obligation_id, "-", args.response,
            head_commit(), now_utc(), clean_note(args.note)]


APPENDERS = {
    "apply": cmd_apply,
    "open": cmd_open,
    "checkpoint": cmd_checkpoint,
    "terminal": cmd_terminal,
    "respond": cmd_respond,
}

READERS = {
    "validate": cmd_validate,
    "status": cmd_status,
    "may-launch": cmd_may_launch,
}


def build_parser() -> argparse.ArgumentParser:
    ap = argparse.ArgumentParser(
        prog="crrg-episode",
        description="Append-only research episode log (Spec §22, §23)",
    )
    ap.add_argument("--threshold", type=int, default=DEFAULT_THRESHOLD,
                    help=f"stall threshold (default {DEFAULT_THRESHOLD})")
    sub = ap.add_subparsers(dest="command", required=True)

    p = sub.add_parser("open")
    p.add_argument("log")
    p.add_argument("episode_id")
    p.add_argument("obligation_id")
    p.add_argument("mechanism_id")
    p.add_argument("start_ref")
    # A trailing positional cannot follow a value-bearing flag in argparse, so an
    # optional note goes BEFORE `--mode`. Documented in the usage header.
    p.add_argument("note", nargs="?", default="-")
    p.add_argument("--mode", default="normal", choices=("normal", "novelty"),
                   help="research mode for this episode; `novelty` is required "
                        "while the obligation is NOVELTY_REQUIRED (§31.4)")

    p = sub.add_parser("checkpoint")
    p.add_argument("log")
    p.add_argument("episode_id")
    p.add_argument("ref")
    p.add_argument("note", nargs="?", default="-")

    p = sub.add_parser("apply")
    p.add_argument("log")
    p.add_argument("episode_id")
    p.add_argument("effect", choices=EFFECTS)
    p.add_argument("note", nargs="?", default="-")

    p = sub.add_parser("terminal")
    p.add_argument("log")
    p.add_argument("episode_id")
    p.add_argument("outcome")
    p.add_argument("note", nargs="?", default="-")

    p = sub.add_parser("respond")
    p.add_argument("log")
    p.add_argument("obligation_id")
    p.add_argument("response")
    p.add_argument("note", nargs="?", default="-")

    p = sub.add_parser("status")
    p.add_argument("log")
    p.add_argument("obligation_id", nargs="?", default=None)

    p = sub.add_parser("may-launch")
    p.add_argument("log")
    p.add_argument("obligation_id")
    p.add_argument("mechanism_id")

    p = sub.add_parser("validate")
    p.add_argument("log")
    return ap


def main() -> int:
    args = build_parser().parse_args()
    path = Path(args.log)
    args.log = str(path)
    before = None

    try:
        if not path.is_file():
            raise Malformed(f"no episode log at {path}. Create it first, e.g. "
                            "`printf '# CRRG episode log\\n' > <log>`.")
        before = digest(path)
        rows = read_rows(path)
        obligations = replay(rows, args.threshold)

        if args.command in READERS:
            return READERS[args.command](args, rows, obligations)

        new_rows = APPENDERS[args.command](args, rows, obligations, before)
        # Every appender returns a LIST: `terminal` contributes the episode's
        # derived checkpoints ahead of its terminal row (§33.1), the rest one row.
        if new_rows and isinstance(new_rows[0], str):
            new_rows = [new_rows]

        # The log with the new rows must satisfy the same rules the old one did --
        # all of them together, since a derived checkpoint and the terminal that
        # follows it are only legal as a pair.
        candidate = rows + [Row(len(rows) + i + 1, f) for i, f in enumerate(new_rows)]
        replay(candidate, args.threshold)

        append_rows(path, new_rows, before)
        fields = new_rows[-1]

    except Violation as e:
        print(f"EPISODE LOG REJECTED: {e}", file=sys.stderr)
        return untouched_or_worse(path, before, EXIT_MALFORMED)
    except Malformed as e:
        print(f"EPISODE LOG MALFORMED: {e}", file=sys.stderr)
        return untouched_or_worse(path, before, EXIT_MALFORMED)

    print("appended:")
    for f in new_rows:
        print("  " + "\t".join(f))
    for f in new_rows[:-1]:
        if f[0] == "CHECKPOINT":
            print(f"recorded: CHECKPOINT {f[4]} on obligation {f[2]} (derived)")
    print(f"recorded: {fields[0]} {fields[4]} on obligation {fields[2]}")

    if args.command == "terminal":
        code = OUTCOME_EXIT.get(args.outcome, EXIT_OK)
        print(f"terminal outcome: {args.outcome} (exit {code}, per §19.2)")
        if args.outcome == "noTransition":
            st = replay(rows + [Row(0, fields)], args.threshold)[fields[2]]
            print(f"  no-transition-count: {st['count']}")
            print(f"  blocked: {'yes' if st['blocked'] else 'no'}")
            print(PERSISTENCE_BLOCK)
        return code
    return EXIT_OK


def untouched_or_worse(path: Path, before, code: int) -> int:
    """Every failing path leaves the log byte-identical; verified, not asserted."""
    if before is not None and path.is_file() and digest(path) != before:
        print("crrg-episode: INTERNAL ERROR — the log changed on a failing path",
              file=sys.stderr)
    return code


if __name__ == "__main__":
    sys.exit(main())
