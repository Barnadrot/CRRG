#!/usr/bin/env bash
set -euo pipefail

# Print a human-readable summary of the CRRG state.
# For the standalone library this checks build status and lists
# available primitives. Downstream adapters extend this with
# project-specific frontier rendering.

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CRRG_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

echo "=== CRRG Status ==="
echo "Repository: $CRRG_ROOT"
echo "Branch: $(cd "$CRRG_ROOT" && git rev-parse --abbrev-ref HEAD 2>/dev/null || echo 'unknown')"
echo "Commit: $(cd "$CRRG_ROOT" && git rev-parse --short HEAD 2>/dev/null || echo 'unknown')"
echo ""

cd "$CRRG_ROOT"

echo "Core modules:"
for f in CRRG/Basic.lean CRRG/Split.lean CRRG/Witness.lean \
         CRRG/Guarded.lean CRRG/Escape.lean CRRG/Frontier.lean \
         CRRG/Candidate.lean CRRG/Audit.lean; do
  if [ -f "$f" ]; then
    echo "  $f: present"
  else
    echo "  $f: MISSING"
  fi
done
echo ""

echo "Test modules:"
for f in Test/Support/ExpectFailure.lean \
         Test/Synthetic/Edge.lean Test/Synthetic/Witness.lean \
         Test/Synthetic/Split.lean Test/Synthetic/Refinement.lean \
         Test/Synthetic/Guarded.lean Test/Synthetic/Escape.lean \
         Test/Synthetic/CandidateSeal.lean Test/Synthetic/NegativeTests.lean; do
  if [ -f "$f" ]; then
    echo "  $f: present"
  else
    echo "  $f: MISSING"
  fi
done
echo ""

echo "Build status:"
if lake build CRRG >/dev/null 2>&1; then
  echo "  CRRG library: OK"
else
  echo "  CRRG library: FAILED"
fi

if lake build Test >/dev/null 2>&1; then
  echo "  Test suite: OK"
else
  echo "  Test suite: FAILED"
fi

echo ""
echo "Axiom audit:"
if "$SCRIPT_DIR/crrg-audit" >/dev/null 2>&1; then
  echo "  no banned axiom dependencies"
else
  echo "  FAILED - banned axiom dependency present (run scripts/crrg-check)"
fi

echo ""
echo "Negative tests (constructions that MUST be rejected):"
echo "  $(grep -c '^#expect_failure' Test/Synthetic/*.lean | awk -F: '{s+=$2} END {print s}') asserted rejections"

echo ""
echo "=== End Status ==="
