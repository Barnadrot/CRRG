#!/usr/bin/env python3
"""Validate a reduction-depth classification record (Spec §10).

Usage:
    crrg-depth-check --file <outcome-or-audit-file>

§10 asks a live deployment to classify its active state before it moves the
graph:

    OVERREDUCED   step upward; identify concrete information lost by the child
    RIGHT-DEPTH   keep the current parent; recent failures are mechanism failures
    UNDERREDUCED  give an explicit certified candidate refinement below it

The accepted block, anywhere in the file:

    depth: OVERREDUCED          depth: RIGHT-DEPTH        depth: UNDERREDUCED
    ancestor: <id>              mechanism: <text>         refinement: <decl>
    lost-information: <text>    failure-class: <text>
    failed-mechanism: <text>

WHAT THIS DOES NOT DO
---------------------
It does not judge whether the classification is *correct*. Deciding that a leaf
is genuinely overreduced is a research judgement about mathematics, and a script
that pretended to make it would be inventing an authority CRRG does not have —
the same error as scoring "how much progress" a refinement represents.

What it enforces is that the judgement was **made and written down**. §10's
value is that stepping deeper is a decision rather than a default; an agent that
refines every iteration without ever saying which of the three states it is in
has not made that decision, it has skipped it. So the required fields are the
ones that cannot be filled in without having actually thought about the
question: naming the ancestor you are returning to, the information the child
lost, the mechanism that failed.

Empty or whitespace-only values are rejected for the same reason. A field
present but blank is the shape of the judgement without the judgement.
"""

import argparse
import re
import sys
from pathlib import Path

CLASSES = {
    "OVERREDUCED": ("ancestor", "lost-information", "failed-mechanism"),
    "RIGHT-DEPTH": ("mechanism", "failure-class"),
    "UNDERREDUCED": ("refinement",),
}

FIELD = re.compile(r"^\s*([A-Za-z][A-Za-z-]*)\s*:\s*(.*)$")


def fail(msg: str) -> int:
    print(f"DEPTH RECORD REJECTED: {msg}", file=sys.stderr)
    return 1


def main() -> int:
    ap = argparse.ArgumentParser(description="Validate a §10 reduction-depth record")
    ap.add_argument("--file", required=True)
    args = ap.parse_args()

    path = Path(args.file)
    if not path.is_file():
        return fail(f"no such file: {path}")

    fields: dict[str, str] = {}
    depth_values = []
    for line in path.read_text().splitlines():
        m = FIELD.match(line)
        if not m:
            continue
        key, value = m.group(1).strip().lower(), m.group(2).strip()
        if key == "depth":
            depth_values.append(value)
        # First occurrence wins, so a later free-text line mentioning
        # "mechanism:" cannot overwrite the declared record.
        fields.setdefault(key, value)

    if not depth_values:
        return fail(
            "no `depth:` line. §10 requires the active state to be classified as "
            "OVERREDUCED, RIGHT-DEPTH or UNDERREDUCED before the graph moves."
        )
    if len(depth_values) > 1:
        return fail(
            f"{len(depth_values)} `depth:` lines ({', '.join(depth_values)}); "
            "exactly one classification is required. Two classifications is no "
            "classification."
        )

    depth = depth_values[0].strip().upper()
    if depth not in CLASSES:
        return fail(
            f"unknown depth class {depth_values[0]!r}. §10 admits exactly: "
            + ", ".join(CLASSES)
        )

    required = CLASSES[depth]
    missing = [f for f in required if f not in fields]
    if missing:
        return fail(
            f"{depth} requires {', '.join(required)}; missing: {', '.join(missing)}"
        )
    blank = [f for f in required if not fields[f]]
    if blank:
        return fail(
            f"{depth} has empty field(s): {', '.join(blank)}. A field present but "
            "blank is the shape of the judgement without the judgement."
        )

    print(f"depth: {depth}")
    for f in required:
        print(f"  {f}: {fields[f]}")
    print(f"depth record OK ({depth})")
    return 0


if __name__ == "__main__":
    sys.exit(main())
