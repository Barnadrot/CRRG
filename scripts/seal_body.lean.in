
-- The ONE-DECLARATION driver. Everything that decides what a seal IS lives in
-- `seal_common.lean.in`, which `crrg-seal` concatenates ahead of this file; this
-- driver only chooses the declaration and lets the shared emitter print it.
run_cmd do
  let declStr := ((← IO.getEnv "CRRG_SEAL_DECL").getD "").trimAscii.toString
  if declStr.isEmpty then
    throwError "crrg-seal: no declaration given"
  let declName := declStr.toName
  let env := (← getEnv).setExporting false
  let scopeStr := ((← IO.getEnv "CRRG_SEAL_SCOPE").getD "").trimAscii.toString
  crrgEmitSeal env declName scopeStr
