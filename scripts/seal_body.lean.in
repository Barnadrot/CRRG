
open Lean Elab Command

/-- Pretty-printer options chosen for **hash stability**, not for reading.

    A seal hash exists to detect that a declaration's meaning changed while its
    name stayed the same (§8.4). It is therefore worse than useless if it also
    changes when nothing meaningful did: a seal that cries wolf gets
    re-baselined, and a re-baselined seal anchors nothing.

    The default pretty-printer is unstable in exactly the wrong ways. It elides
    implicit arguments and instances, uses whatever notation happens to be in
    scope, and wraps at the ambient width — so importing an unrelated module
    that introduces a notation can change the text of an unchanged proposition.
    Three options remove all three: `pp.all` prints fully explicit terms with no
    notation and no elision; an enormous `format.width` puts everything on one
    line so wrapping cannot vary; and `pp.unicode.fun` is fixed so the arrow
    glyph is not a variable.

    A false alarm remains possible and is the safe direction — it forces a human
    to look. A false *pass* is the one this must not have. -/
def crrgSealOptions (o : Options) : Options :=
  let o := o.setBool `pp.all true
  let o := o.setBool `pp.unicode.fun false
  let o := o.set `format.width (10000000 : Nat)
  o.set `pp.maxSteps (10000000 : Nat)

def crrgRender (e : Expr) : CommandElabM String :=
  liftTermElabM do
    withOptions crrgSealOptions do
      pure (toString (← Lean.PrettyPrinter.ppExpr e))

/-- Whether a constant's **body** carries meaning that a seal must cover.

    A `def` does: `def E17Target : Prop := A → B → C` *is* its body, and editing
    that body is precisely the attack §8.5 forbids. A `theorem` does not — its
    type is the proposition and its body is a proof, which proof irrelevance
    makes interchangeable with any other. Hashing theorem bodies would break
    every seal on every proof refactor, a false alarm on ordinary work, and that
    is how seals get abandoned. -/
def crrgBodyIsMeaning : ConstantInfo → Bool
  | .defnInfo _ => true
  | .opaqueInfo _ => true
  | _ => false

/-- The constants a declaration's type and, where meaningful, body refer to. -/
def crrgRefsOf (env : Environment) (n : Name) : Array Name :=
  match env.find? n with
  | none => #[]
  | some ci =>
    let fromType := ci.type.getUsedConstants
    if crrgBodyIsMeaning ci then
      match ci.value? (allowOpaque := true) with
      | some v => fromType ++ v.getUsedConstants
      | none => fromType
    else fromType

/-- Every in-scope constant the target transitively depends on, sorted.

    Restricting to a namespace prefix is a deliberate boundary. A candidate
    target is rarely self-contained — `def E3Target : Prop := H2Result → Count →
    Budget` means nothing without the three definitions it names, and editing
    any of *those* retargets the candidate exactly as effectively as editing the
    target itself. So the seal has to cover them.

    It does not cover Mathlib or Lean core, which are pinned by the Lake
    manifest rather than by a seal, and hashing them would make every seal
    depend on a multi-gigabyte dependency closure. The scope is the project's
    own namespace: the part a research agent can actually edit.

    **Several scopes are allowed, and are usually required.** An adapter's
    targets and its mathematics normally live in different namespaces — the
    graph declares `MyGraph.SomeTerm` while the semantics sit under
    `TheProject.*`. Walking only one of them stops at the first constant in the
    other, so everything past that point silently leaves the hash. That is the
    "accidentally narrow namespace prefix" failure: the seal still verifies, and
    covers less than its reader assumes. -/
def crrgScopedClosure (env : Environment) (root : Name) (scopes : List Name) :
    Array Name := Id.run do
  let inScope (n : Name) : Bool := scopes.any (fun s => s.isPrefixOf n)
  let mut seen : NameSet := {}
  let mut queue : Array Name := #[root]
  seen := seen.insert root
  let mut out : Array Name := #[]
  let mut idx := 0
  let constCount := env.constants.fold (fun acc _ _ => acc + 1) 0
  -- Fuelled rather than `partial`: `crrg-banned` rejects `partial` in CRRG's
  -- sources and the tooling should not hold itself to a lower standard.
  for _ in [0:constCount + 1] do
    if h : idx < queue.size then
      let n := queue[idx]
      idx := idx + 1
      let here := inScope n
      if n != root && here then
        out := out.push n
      -- Only walk *through* in-scope constants. A Mathlib lemma's own
      -- dependencies are Mathlib's business, and following them would drag the
      -- whole library into the hash.
      if n == root || here then
        for m in crrgRefsOf env n do
          unless seen.contains m do
            seen := seen.insert m
            queue := queue.push m
    else
      break
  return out.qsort (fun a b => a.toString < b.toString)

/-- The sealed text for one constant: its universes, its type, and its body
    where the body is what carries the meaning. -/
def crrgSealEntry (env : Environment) (n : Name) : CommandElabM String := do
  let some ci := env.find? n | return s!"{n}: MISSING"
  let ty ← crrgRender ci.type
  let body ←
    if crrgBodyIsMeaning ci then
      match ci.value? (allowOpaque := true) with
      | some v => do
        let r ← crrgRender v
        pure s!"\n  := {r}"
      | none => pure ""
    else pure ""
  return s!"{n}\n  universes: {ci.levelParams}\n  : {ty}{body}"

run_cmd do
  let declStr := ((← IO.getEnv "CRRG_SEAL_DECL").getD "").trimAscii.toString
  if declStr.isEmpty then
    throwError "crrg-seal: no declaration given"
  let declName := declStr.toName
  let env := (← getEnv).setExporting false
  let some ci := env.find? declName
    | throwError m!"crrg-seal: no such declaration: {declName}"

  -- Default scope: the target's own root namespace. That is the project's
  -- editable surface, and it is what a downstream adapter wants.
  let scopeStr := ((← IO.getEnv "CRRG_SEAL_SCOPE").getD "").trimAscii.toString
  let scopes : List Name :=
    if scopeStr.isEmpty then
      match declName.components with
      | c :: _ => [c]
      | [] => [declName]
    else
      (scopeStr.splitOn ",").filterMap fun t =>
        let t := t.trimAscii.toString
        if t.isEmpty then none else some t.toName
  if scopes.isEmpty then
    throwError "crrg-seal: CRRG_SEAL_SCOPE is set but names no namespace"

  let kind :=
    match ci with
    | .thmInfo _ => "theorem"
    | .axiomInfo _ => "axiom"
    | .defnInfo _ => "def"
    | .opaqueInfo _ => "opaque"
    | _ => "other"

  -- A candidate target should denote a proposition: `def X : Prop := ...` has
  -- type `Prop`, and a `theorem`'s type *is* the proposition. Anything else is
  -- very likely a mistake, and saying so costs less than a puzzled reader.
  let typeIsProp ← liftTermElabM do Meta.isProp ci.type
  let denotesProp := typeIsProp || ci.type.isProp

  let readable ← liftTermElabM do
    pure (toString (← Lean.PrettyPrinter.ppExpr ci.type))
  let readableBody ←
    if crrgBodyIsMeaning ci then
      match ci.value? (allowOpaque := true) with
      | some v => liftTermElabM do pure (toString (← Lean.PrettyPrinter.ppExpr v))
      | none => pure ""
    else pure ""

  let deps := crrgScopedClosure env declName scopes
  let mut entries : Array String := #[← crrgSealEntry env declName]
  for d in deps do
    entries := entries.push (← crrgSealEntry env d)

  IO.println s!"CRRG_SEAL_DECL {declName}"
  IO.println s!"CRRG_SEAL_KIND {kind}"
  IO.println s!"CRRG_SEAL_DENOTES_PROP {denotesProp}"
  IO.println s!"CRRG_SEAL_SCOPE {scopes}"
  IO.println s!"CRRG_SEAL_DEPS {deps.size}"
  IO.println "CRRG_SEAL_READABLE_BEGIN"
  IO.println readable
  unless readableBody.isEmpty do
    IO.println s!"  := {readableBody}"
  IO.println "CRRG_SEAL_READABLE_END"
  -- Everything strictly between these markers, and nothing else, is hashed.
  IO.println "CRRG_SEAL_CANONICAL_BEGIN"
  IO.println s!"scopes: {scopes}"
  for e in entries do
    IO.println e
  IO.println "CRRG_SEAL_CANONICAL_END"
