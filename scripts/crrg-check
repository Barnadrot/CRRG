#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CRRG_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

echo "=== CRRG Check ==="
echo "Root: $CRRG_ROOT"
echo ""

cd "$CRRG_ROOT"

echo "[1/4] Building CRRG library..."
lake build CRRG
echo "  OK"
echo ""

echo "[2/4] Building test suite..."
lake build Test
echo "  OK"
echo ""

echo "[3/4] Declaration audit (verifying core types exist)..."
TMPFILE="${CRRG_ROOT}/.crrg_check_tmp_$$.lean"
trap 'rm -f "$TMPFILE"' EXIT
cat > "$TMPFILE" <<'LEAN'
import CRRG
#check @CRRG.Goal
#check @CRRG.Edge
#check @CRRG.Split
#check @CRRG.BadNode
#check @CRRG.WitnessMap
#check @CRRG.WitnessSplit
#check @CRRG.GuardedMap
#check @CRRG.EscapeMap
#check @CRRG.Frontier
#check @CRRG.SealedCandidate
#check @CRRG.CandidateEdge
LEAN
lake env lean "$TMPFILE"
echo "  All core declarations present."
echo ""

echo "[4/4] Transitive axiom audit (Spec 12.2)..."
"$SCRIPT_DIR/crrg-audit"
echo ""

echo "=== CRRG Check PASSED ==="
