#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CRRG_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

echo "=== CRRG Check ==="
echo "Root: $CRRG_ROOT"
echo ""

cd "$CRRG_ROOT"

echo "[1/5] Building CRRG library..."
lake build CRRG
echo "  OK"
echo ""

echo "[2/5] Building test suite..."
lake build Test
echo "  OK"
echo ""

echo "[3/5] Declaration audit (verifying core types exist)..."
TMPFILE="${CRRG_ROOT}/.crrg_check_tmp_$$.lean"
trap 'rm -f "$TMPFILE"' EXIT
cat > "$TMPFILE" <<'LEAN'
import CRRG
#check @CRRG.Goal
#check @CRRG.Edge
#check @CRRG.Split
#check @CRRG.BadNode
#check @CRRG.WitnessMap
#check @CRRG.WitnessSplit
#check @CRRG.GuardedMap
#check @CRRG.EscapeMap
#check @CRRG.Frontier
#check @CRRG.SealedCandidate
#check @CRRG.DraftCandidate
#check @CRRG.Outcome
#check @CRRG.ResolvedCandidate
#check @CRRG.PromotionQueue
#check @CRRG.CandidateStatus
#check @CRRG.MonotoneFamily
#check @CRRG.Progress
#check @CRRG.TaskStatus
#check @CRRG.FrontierReport
#check @CRRG.QueueReport
LEAN
lake env lean "$TMPFILE"
echo "  All core declarations present."
echo ""

echo "[4/5] Transitive axiom audit (Spec 14.2 item 3)..."
"$SCRIPT_DIR/crrg-audit"
echo ""

echo "[5/5] Banned-construct scan (Spec 14.2 item 2, 5.6, 14.2 item 7)..."
"$SCRIPT_DIR/crrg-banned"
echo ""

echo "=== CRRG Check PASSED ==="
