#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CRRG_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

echo "=== CRRG Check ==="
echo "Root: $CRRG_ROOT"
echo ""

cd "$CRRG_ROOT"

echo "[1/7] Script hygiene (executable bit recorded in the git index)..."
# The gate invokes crrg-audit and crrg-banned directly, so a script that is
# executable in the working tree but recorded as 100644 in the index breaks the
# gate on every fresh clone -- while still passing here. That is exactly what
# happened: both were committed without the bit from a machine whose git does
# not track file mode. Check the *index*, not the filesystem.
if git -C "$CRRG_ROOT" rev-parse --git-dir >/dev/null 2>&1; then
  nonexec="$(git -C "$CRRG_ROOT" ls-files -s scripts/ \
    | awk '$1 != "100755" && $4 ~ /scripts\/crrg-/ { print "    " $4 " is " $1 }')"
  if [ -n "$nonexec" ]; then
    echo "  FAILED - these gate scripts are not executable in the git index:" >&2
    echo "$nonexec" >&2
    echo "  Fix with: git update-index --chmod=+x <path>" >&2
    exit 1
  fi
  echo "  All crrg-* scripts are 100755 in the index."
else
  echo "  (not a git checkout; skipped)"
fi
echo ""

echo "[2/7] Building CRRG library (primary toolchain)..."
lake build CRRG
echo "  OK"
echo ""

echo "[3/7] Building test suite (primary toolchain)..."
lake build CRRGTest Test
echo "  OK"
echo ""

echo "[4/7] Cross-toolchain portability (Spec 2.2, 2.4)..."
# Steps 2 and 3 prove the primary toolchain works, which is the common failure
# and worth reporting first. This step proves the *portability claim*: CRRG's
# core is Lean-core-only, so a consumer on any supported toolchain must get a
# clean build. Nothing checked that until OPEN-01 was found by a downstream
# project rather than by this gate.
"$SCRIPT_DIR/crrg-portability"
echo ""

echo "[5/7] Declaration audit (verifying core types exist)..."
TMPFILE="${CRRG_ROOT}/.crrg_check_tmp_$$.lean"
trap 'rm -f "$TMPFILE"' EXIT
cat > "$TMPFILE" <<'LEAN'
import CRRG
#check @CRRG.Goal
#check @CRRG.Edge
#check @CRRG.Split
#check @CRRG.BadNode
#check @CRRG.WitnessMap
#check @CRRG.WitnessSplit
#check @CRRG.GuardedMap
#check @CRRG.EscapeMap
#check @CRRG.Frontier
#check @CRRG.SealedCandidate
#check @CRRG.DraftCandidate
#check @CRRG.Outcome
#check @CRRG.ResolvedCandidate
#check @CRRG.PromotionQueue
#check @CRRG.CandidateStatus
#check @CRRG.MonotoneFamily
#check @CRRG.Progress
#check @CRRG.TaskStatus
#check @CRRG.FrontierReport
#check @CRRG.QueueReport
LEAN
lake env lean "$TMPFILE"
echo "  All core declarations present."
echo ""

echo "[6/7] Transitive axiom audit (Spec 14.2 item 3)..."
"$SCRIPT_DIR/crrg-audit"
echo ""

echo "[7/7] Banned-construct scan (Spec 14.2 item 2, 5.6, 14.2 item 7)..."
"$SCRIPT_DIR/crrg-banned"
echo ""

echo "=== CRRG Check PASSED ==="
