#!/usr/bin/env python3
"""Generic live-launch dispatch (Spec §16.6.1).

Usage:
    crrg-live-run --config <cfg.json> --model codex|kimi|claude
    crrg-live-run --config <cfg.json> --mode  normal|stalled|novelty

CRRG owns the dispatch semantics. The **downstream integrator owns every
application-specific detail**, including the exact executable and argument
vector for each model adapter. CRRG does not infer vendor flags, does not know
what any vendor calls its unattended mode, and must never grow a table of them:
the moment it does, CRRG is coupled to a vendor release cycle it has no business
tracking, and a deployment on a CLI CRRG has not heard of stops working.

Config (JSON):

    {
      "repo_root": ".",
      "program":   "<downstream programme path>",
      "preflight": ["...", "..."],
      "gate":      ["...", "..."],
      "operator_bans": "<bans.tsv>",
      "models": {
        "codex":  ["executable", "...", "{PROMPT}"],
        "kimi":   ["executable", "...", "{PROMPT}"],
        "claude": ["executable", "...", "{PROMPT}"]
      },

      "modes": {                          <- optional (Spec §31.5)
        "normal":  "claude",
        "stalled": "codex",
        "novelty": "kimi"
      }
    }

Rules, all enforced here:

* each model argv contains **exactly one** `{PROMPT}` token -- zero means the
  agent is launched with no instruction, more than one means the instruction is
  duplicated and the second copy silently wins on most CLIs. Both are
  configuration bugs that look like model misbehaviour at 3am, so they are
  rejected before anything is executed;
* the substituted instruction is fixed by CRRG, not by the downstream:

      Read <program> fully and start the experiment.

  The programme file is the contract. A launcher that could vary the
  instruction could vary the contract, and then the launcher would be part of
  the trust story -- which §16.6.1 explicitly says it is not;
* the downstream preflight runs first, from `repo_root`, and a non-zero exit
  aborts the launch;
* the model is exec'd from `repo_root`.

THE MODE SIGNAL (Spec §31.5)
----------------------------
`--mode normal|stalled|novelty` selects an adapter through the config's optional
`modes` table, which maps a mode name to a KEY IN `models` -- never to an argv,
an executable or a flag. A deployment may answer a stalled or novelty-required
obligation with a higher-effort reasoner, a different model family, or a swarm;
which of those it is remains entirely the downstream's business.

The three mode names are the only new vocabulary CRRG learns, and they are
CRRG's own scheduler states, not anyone's product. Everything on the other side
of the mapping comes from the caller's config, so the argument above is
unchanged: there is still no vendor table here, and a deployment on a CLI CRRG
has never heard of still works.

**The mode selects the adapter, never the contract.** The substituted
instruction is the same fixed sentence in every mode. A mode that could vary the
instruction would be varying the programme, and the launcher would be back in
the trust story §16.6.1 keeps it out of.

**Model choice changes no mathematical CRRG state.** Nothing on this path
touches a seal, a frontier, a root or a registry, and `--print-argv` exists so
that can be inspected without running anything.
"""

import argparse
import json
import os
import subprocess
import sys
from pathlib import Path

PROMPT_TOKEN = "{PROMPT}"
REQUIRED = ("repo_root", "program", "preflight", "gate", "operator_bans", "models")
REQUIRED_MODELS = ("codex", "kimi", "claude")

# §31.5's generic scheduler signal. CRRG's own states -- what a deployment maps
# them onto is the deployment's business, and is read from the config.
MODES = ("normal", "stalled", "novelty")


def fail(kind: str, msg: str) -> "NoReturn":  # type: ignore[name-defined]
    print(f"LAUNCH REJECTED [{kind}]: {msg}", file=sys.stderr)
    sys.exit(2)


def load_config(path: Path) -> dict:
    if not path.is_file():
        fail("config", f"no config at {path}")
    try:
        cfg = json.loads(path.read_text())
    except json.JSONDecodeError as exc:
        fail("config", f"{path} is not valid JSON: {exc}")
    if not isinstance(cfg, dict):
        fail("config", f"{path} must contain a JSON object")

    missing = [k for k in REQUIRED if k not in cfg]
    if missing:
        fail("config", f"{path} is missing required field(s): {', '.join(missing)}")

    for key in ("preflight", "gate"):
        if not isinstance(cfg[key], list) or not cfg[key] or not all(
            isinstance(a, str) for a in cfg[key]
        ):
            fail("config", f"'{key}' must be a non-empty list of strings")

    models = cfg["models"]
    if not isinstance(models, dict):
        fail("config", "'models' must be an object")
    missing = [m for m in REQUIRED_MODELS if m not in models]
    if missing:
        fail(
            "config",
            "a live deployment must configure every adapter class "
            f"(Spec §16.6.1); missing: {', '.join(missing)}",
        )

    for name, argv in models.items():
        if not isinstance(argv, list) or not argv or not all(isinstance(a, str) for a in argv):
            fail("config", f"models.{name} must be a non-empty list of strings")
        hits = [i for i, a in enumerate(argv) if PROMPT_TOKEN in a]
        if len(hits) == 0:
            fail(
                "prompt-token",
                f"models.{name} contains no {PROMPT_TOKEN} token, so the agent would be "
                "launched with no instruction at all.",
            )
        if len(hits) > 1:
            fail(
                "prompt-token",
                f"models.{name} contains {len(hits)} {PROMPT_TOKEN} tokens "
                f"(argv positions {hits}); exactly one is required. Two copies of the "
                "instruction is a configuration bug that presents as model misbehaviour.",
            )
    return cfg


def main() -> int:
    ap = argparse.ArgumentParser(add_help=True, description="CRRG generic live launch")
    ap.add_argument("--config", required=True)
    # Exactly one of the two. `--model` names an adapter directly, as it always
    # has; `--mode` names a scheduler state and lets the config say which adapter
    # answers it (§31.5). Requiring the group preserves today's behaviour that a
    # launch must state what it is launching.
    picker = ap.add_mutually_exclusive_group(required=True)
    picker.add_argument("--model", choices=list(REQUIRED_MODELS))
    picker.add_argument("--mode", choices=list(MODES))
    ap.add_argument(
        "--print-argv",
        action="store_true",
        help="validate, resolve the argv, print it, and exit without running anything",
    )
    args = ap.parse_args()

    cfg_path = Path(args.config).resolve()
    cfg = load_config(cfg_path)

    # Paths in the config are relative to the config file, so a downstream repo
    # can be checked out anywhere.
    base = cfg_path.parent
    repo_root = (base / cfg["repo_root"]).resolve()
    if not repo_root.is_dir():
        fail("config", f"repo_root {repo_root} is not a directory")

    program = cfg["program"]
    if not (repo_root / program).is_file():
        fail("config", f"programme {program} does not exist under {repo_root}")

    bans = (base / cfg["operator_bans"]).resolve()
    policy = Path(__file__).resolve().parent / "crrg-policy-check"
    proc = subprocess.run(
        [sys.executable, str(policy), "--bans", str(bans), "--validate"],
        capture_output=True,
        text=True,
    )
    if proc.returncode != 0:
        sys.stderr.write(proc.stderr)
        fail("policy", f"the operator ban file {bans} is malformed; refusing to launch")

    # Resolve the mode to an adapter, if that is how this launch was asked for.
    #
    # Validated HERE rather than in load_config, so a config with no `modes`
    # table -- or one whose table is irrelevant to this launch -- behaves exactly
    # as it did before §31.5 existed. The mapping is only ever a promise about
    # the launch being made.
    model = args.model
    if args.mode is not None:
        modes = cfg.get("modes")
        if not isinstance(modes, dict) or args.mode not in modes:
            fail(
                "mode",
                f"--mode {args.mode} was requested but {cfg_path} maps no such mode. "
                f"Add \"modes\": {{ \"{args.mode}\": \"<one of "
                f"{', '.join(sorted(cfg['models']))}>\" }}. CRRG does not guess "
                "which adapter answers a scheduler state (Spec §31.5); the "
                "deployment says.",
            )
        model = modes[args.mode]
        if not isinstance(model, str) or model not in cfg["models"]:
            fail(
                "mode",
                f"modes.{args.mode} maps to {model!r}, which is not a key in "
                f"'models' (have: {', '.join(sorted(cfg['models']))}). A mode maps "
                "to an adapter this config defines, never to an executable or an "
                "argv of its own.",
            )

    prompt = f"Read {program} fully and start the experiment."
    argv = [a.replace(PROMPT_TOKEN, prompt) for a in cfg["models"][model]]

    print("=== CRRG live launch ===")
    print(f"config     {cfg_path}")
    print(f"repo_root  {repo_root}")
    print(f"programme  {program}")
    print(f"bans       {bans}")
    if args.mode is not None:
        print(f"mode       {args.mode}  ->  {model}")
    print(f"model      {model}")
    print(f"argv       {argv}")
    print("")

    if args.print_argv:
        print("--print-argv: nothing was launched.")
        return 0

    print(f"preflight  {cfg['preflight']}")
    pre = subprocess.run(cfg["preflight"], cwd=str(repo_root))
    if pre.returncode != 0:
        fail("preflight", f"downstream preflight exited {pre.returncode}; not launching")
    print("preflight: OK")
    print("")
    print(f"launching {model} from {repo_root}")
    sys.stdout.flush()

    os.chdir(repo_root)
    try:
        os.execvp(argv[0], argv)
    except OSError as exc:
        fail("exec", f"could not execute {argv[0]!r}: {exc}")
    return 0  # unreachable


if __name__ == "__main__":
    sys.exit(main())
