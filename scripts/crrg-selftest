#!/usr/bin/env bash
set -uo pipefail

# Self-tests for the gate's own tools.
#
# CRRG's argument is that its checks cannot be talked around. A check that
# silently passes when it should fail is worse than no check at all, because it
# is *reported* as evidence. `crrg-forbid` had exactly that bug during
# development: `ConstantInfo.value?` returns `none` for every `theorem` unless
# asked for opaque values, so the audit saw statements and never proofs, and
# cheerfully certified that a proof routed straight through the forbidden lemma
# had not used it. It passed its intended use case while being useless.
#
# So each tool is exercised on a case it must accept *and* a case it must
# reject. A tool that only ever gets run on inputs it passes is untested.

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CRRG_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$CRRG_ROOT"

pass=0
fail=0

# expect <ok|reject> <expected-output-pattern> <description> <command...>
#
# A rejection is only a pass if it happened for the *stated reason*. Exit status
# alone is not enough: during development these tests "passed" while every
# invocation was actually dying on an unrelated stale-olean error, which is the
# same class of false confidence the tools themselves exist to prevent.
expect() {
  local want="$1" pattern="$2" desc="$3"; shift 3
  local out status
  out="$("$@" 2>&1)"; status=$?
  local okstatus=false reason=false
  { [ "$want" = ok ] && [ $status -eq 0 ]; } && okstatus=true
  { [ "$want" = reject ] && [ $status -ne 0 ]; } && okstatus=true
  grep -qF -- "$pattern" <<< "$out" && reason=true
  if $okstatus && $reason; then
    echo "  PASS  $desc"
    pass=$((pass + 1))
  else
    if $okstatus; then
      echo "  FAIL  $desc (right status, WRONG REASON: expected output to contain \"$pattern\")"
    else
      echo "  FAIL  $desc (exit $status, wanted $want)"
    fi
    echo "$out" | sed 's/^/          /' | tail -8
    fail=$((fail + 1))
  fi
}

echo "=== CRRG gate self-tests ==="
echo ""

# The audits read oleans; a build left behind by a *different* toolchain makes
# every one of them die on an incompatible header, which would otherwise look
# like a rejection. Rebuild under the primary toolchain first so a failure below
# is about the tool and not about the tree.
lake build CRRG CRRGTest Test >/dev/null 2>&1 || {
  echo "  cannot build CRRG under the primary toolchain; self-tests cannot run" >&2
  exit 1
}

echo "crrg-forbid:"

# `CRRG.Split.toEdge` is a `theorem` whose proof is literally `⟨s.discharge⟩`.
# This is the regression test for the opaque-value bug: if `crrg-forbid` ever
# stops reading theorem *proofs*, this reverts to a false pass.
expect reject "FORBIDDEN CRRG.Split.discharge" \
  "detects a forbidden constant used in a theorem's proof" \
  "$SCRIPT_DIR/crrg-forbid" CRRG.Split.toEdge --forbid CRRG.Split.discharge

expect reject "FORBIDDEN CRRG.WitnessSplit.classify" \
  "detects a forbidden constant reached indirectly" \
  "$SCRIPT_DIR/crrg-forbid" CRRG.WitnessSplit.toSplit --forbid CRRG.WitnessSplit.classify

expect ok "forbid audit PASSED" \
  "passes a genuine non-dependency" \
  "$SCRIPT_DIR/crrg-forbid" CRRG.Edge.id --forbid CRRG.Split.discharge

expect ok "forbid audit PASSED" \
  "passes a namespace the root does not touch" \
  "$SCRIPT_DIR/crrg-forbid" CRRG.EscapeMap.closed_parent --forbid-prefix CRRG.GuardedMap

# A prohibition naming something that does not exist forbids nothing, and would
# otherwise report a clean audit -- the most misleading outcome available.
expect reject "forbidden name does not exist" \
  "rejects a misspelled prohibition" \
  "$SCRIPT_DIR/crrg-forbid" CRRG.Edge.id --forbid CRRG.Split.dischrage

expect reject "no such declaration" \
  "rejects a root that does not exist" \
  "$SCRIPT_DIR/crrg-forbid" CRRG.NoSuchDeclaration --forbid CRRG.Split.discharge

expect reject "nothing forbidden" \
  "refuses a vacuous audit with nothing forbidden" \
  "$SCRIPT_DIR/crrg-forbid" CRRG.Edge.id

echo ""
echo "crrg-banned:"

TMPDIR_SELFTEST="$(mktemp -d)"
trap 'rm -rf "$TMPDIR_SELFTEST"' EXIT

cat > "$TMPDIR_SELFTEST/Clean.lean" <<'LEAN'
/-- A doc-comment may quote the banned list -- `sorry`, `native_decide` -- without
tripping the scan, because comments are stripped before matching. -/
theorem fine : 1 = 1 := rfl
LEAN
expect ok "no banned constructs" \
  "accepts a clean file, and does not trip on the list quoted in a comment" \
  "$SCRIPT_DIR/crrg-banned" "$TMPDIR_SELFTEST/Clean.lean"

cat > "$TMPDIR_SELFTEST/Hole.lean" <<'LEAN'
theorem admitted : 1 = 2 := by sorry
LEAN
expect reject "sorry (admitted hole)" \
  "rejects an admitted hole" \
  "$SCRIPT_DIR/crrg-banned" "$TMPDIR_SELFTEST/Hole.lean"

cat > "$TMPDIR_SELFTEST/Native.lean" <<'LEAN'
theorem compiled : 2 + 2 = 4 := by native_decide
LEAN
expect reject "native_decide" \
  "rejects native_decide, which trusts the compiler and not the kernel" \
  "$SCRIPT_DIR/crrg-banned" "$TMPDIR_SELFTEST/Native.lean"

cat > "$TMPDIR_SELFTEST/Aggregate.lean" <<'LEAN'
def completionRatio : Nat := 63
LEAN
expect reject "aggregate progress magnitude" \
  "rejects an aggregate progress magnitude (§5.6)" \
  "$SCRIPT_DIR/crrg-banned" "$TMPDIR_SELFTEST/Aggregate.lean"

echo ""
echo "crrg-seal:"

SEAL_IMPORTS="CRRG,Test.Synthetic.CandidateSeal"
seal_hash() {
  CRRG_IMPORTS="$1" "$SCRIPT_DIR/crrg-seal" "$2" 2>/dev/null \
    | sed -n '/^Seal hash/,+1p' | tail -1 | tr -d '[:space:]'
}

H_STRONG="$(seal_hash "$SEAL_IMPORTS" SealFixture.Strong)"
H_STRONG_AGAIN="$(seal_hash "$SEAL_IMPORTS" SealFixture.Strong)"
H_WEAK="$(seal_hash "$SEAL_IMPORTS" SealFixture.Weakened)"
# A much larger import set. `pp.all` exists so that notation and instances
# arriving from unrelated modules cannot move the hash; if that ever regresses,
# a seal would break for reasons having nothing to do with its target.
H_STRONG_WIDE="$(seal_hash "CRRG,Test" SealFixture.Strong)"

check() {
  if [ "$1" = true ]; then echo "  PASS  $2"; pass=$((pass + 1));
  else echo "  FAIL  $2"; fail=$((fail + 1)); fi
}

[ -n "$H_STRONG" ] && check true "produces a hash for a Prop-valued target" \
  || check false "produces a hash for a Prop-valued target"
[ "$H_STRONG" = "$H_STRONG_AGAIN" ] && check true "hashing is deterministic" \
  || check false "hashing is deterministic"
[ "$H_STRONG" = "$H_STRONG_WIDE" ] && check true "hash is stable under a wider import set" \
  || check false "hash is stable under a wider import set (got $H_STRONG vs $H_STRONG_WIDE)"
[ "$H_STRONG" != "$H_WEAK" ] && check true "a weakened target hashes differently" \
  || check false "a weakened target hashes differently"

# A target that names a helper: the helper must be inside the hash, or editing
# it would retarget the candidate invisibly. Sealing the same declaration with a
# scope that excludes the helper must therefore give a different hash.
H_COMPOSED="$(seal_hash "$SEAL_IMPORTS" SealFixture.Composed)"
H_COMPOSED_NARROW="$(CRRG_SEAL_SCOPE=NoSuchNamespace seal_hash "$SEAL_IMPORTS" SealFixture.Composed)"
[ -n "$H_COMPOSED" ] && [ "$H_COMPOSED" != "$H_COMPOSED_NARROW" ] \
  && check true "the seal covers the target's in-scope dependencies" \
  || check false "the seal covers the target's in-scope dependencies"

# Several scopes must widen the closure. An adapter's targets and its
# mathematics live in different namespaces, so a single-scope seal stops at the
# first constant in the other one and silently covers less than its reader
# assumes -- while still verifying.
H_COMPOSED_WIDE="$(CRRG_SEAL_SCOPE="SealFixture,Nat" seal_hash "$SEAL_IMPORTS" SealFixture.Composed)"
[ -n "$H_COMPOSED_WIDE" ] && [ "$H_COMPOSED_WIDE" != "$H_COMPOSED" ] \
  && check true "a second seal scope widens the sealed closure" \
  || check false "a second seal scope widens the sealed closure"

expect ok "SEAL OK" \
  "--verify accepts the recorded hash" \
  env CRRG_IMPORTS="$SEAL_IMPORTS" "$SCRIPT_DIR/crrg-seal" --verify \
     SealFixture.Strong "$H_STRONG"

# The attack §8.4 assigns to the tooling: the candidate id and the sealed type
# parameter are both unchanged, and only the declaration underneath moved.
expect reject "SEAL BROKEN" \
  "--verify rejects a target that has been retargeted at a weaker proposition" \
  env CRRG_IMPORTS="$SEAL_IMPORTS" "$SCRIPT_DIR/crrg-seal" --verify \
     SealFixture.Weakened "$H_STRONG"

expect reject "no such declaration" \
  "rejects sealing a declaration that does not exist" \
  env CRRG_IMPORTS="$SEAL_IMPORTS" "$SCRIPT_DIR/crrg-seal" SealFixture.NoSuchTarget

printf '%s\t%s\t%s\tHEAD\t2026-01-01T00:00:00Z\tthm\tN1\tN0\n' \
  "S001" "SealFixture.Strong" "$H_STRONG" > "$TMPDIR_SELFTEST/good.tsv"
expect ok "registry verification PASSED" \
  "verifies a registry whose seals still hold" \
  env CRRG_IMPORTS="$SEAL_IMPORTS" "$SCRIPT_DIR/crrg-seal" \
     --verify-registry "$TMPDIR_SELFTEST/good.tsv"

printf '%s\t%s\t%s\tHEAD\t2026-01-01T00:00:00Z\tthm\tN1\tN0\n' \
  "S002" "SealFixture.Weakened" "$H_STRONG" > "$TMPDIR_SELFTEST/bad.tsv"
expect reject "registry verification FAILED" \
  "fails a registry whose seal no longer matches" \
  env CRRG_IMPORTS="$SEAL_IMPORTS" "$SCRIPT_DIR/crrg-seal" \
     --verify-registry "$TMPDIR_SELFTEST/bad.tsv"


echo ""
echo "crrg-register-candidate:"

# A seal is immutable per candidate ID; the REGISTRY that holds seals is not,
# and must not be. A live deployment discovers new exact child propositions
# while it runs -- that is what a certified refinement is -- and each one must
# be sealed before it can become a live leaf. These checks pin the two halves:
# appending is a normal operation, and every way of corrupting an existing row
# is refused with the registry left byte-identical.

REG="$TMPDIR_SELFTEST/live.tsv"
printf '# id\tdecl\thash\tcommit\tcreated\texpected\ttarget\tsources\n' > "$REG"

reg() {
  env CRRG_IMPORTS="$SEAL_IMPORTS" "$SCRIPT_DIR/crrg-register-candidate" \
    --registry "$REG" "$@"
}
reg_fingerprint() { sha256sum "$REG" | cut -d' ' -f1; }

expect ok "registered R001" \
  "registers a fresh candidate and re-verifies the registry" \
  reg --id R001 --decl SealFixture.Strong --expected-theorem Downstream.r001

# Everything below must leave the registry EXACTLY as it is now. Captured once
# and re-checked after each rejection, because "nothing was written" is the
# claim most worth testing and the easiest to get wrong on an error path.
REG_BEFORE="$(reg_fingerprint)"
untouched() {
  if [ "$(reg_fingerprint)" = "$REG_BEFORE" ]; then
    check true "  ...and left the registry byte-identical: $1"
  else
    check false "  ...but MUTATED the registry: $1"
  fi
}

expect reject "duplicate-id" \
  "refuses to reuse a candidate id, even for the same declaration" \
  reg --id R001 --decl SealFixture.Strong
untouched "duplicate id, same declaration"

expect reject "duplicate-id" \
  "refuses to retarget an existing id at a different proposition" \
  reg --id R001 --decl SealFixture.Weakened
untouched "duplicate id, different declaration"

expect reject "duplicate-proposition" \
  "refuses two ids for one proposition, which would make the task list ambiguous" \
  reg --id R002 --decl SealFixture.Strong
untouched "same proposition under a new id"

expect reject "does not elaborate" \
  "refuses a declaration that does not exist" \
  reg --id R003 --decl SealFixture.NoSuchTarget
untouched "nonexistent declaration"

expect reject "must match" \
  "refuses a candidate id that is not an identifier" \
  reg --id "R 004" --decl SealFixture.Weakened
untouched "malformed candidate id"

expect ok "dry run OK" \
  "--dry-run computes the row without writing it" \
  reg --id R005 --decl SealFixture.Weakened --dry-run
untouched "--dry-run"

expect ok "registered R006" \
  "a second legitimate candidate appends" \
  reg --id R006 --decl SealFixture.Weakened

if [ "$(grep -c '^R001' "$REG")" = 1 ] && grep -q "^R001.*$H_STRONG" "$REG"; then
  check true "  ...without disturbing the row that was already there"
else
  check false "  ...without disturbing the row that was already there"
fi

# A registry that would not verify must never be installed, even when the row
# being added is itself perfectly good: the failure is pre-existing, and
# appending to a broken registry would launder it.
BROKEN="$TMPDIR_SELFTEST/broken.tsv"
printf '%s\t%s\t%s\tHEAD\t2026-01-01T00:00:00Z\tthm\tN1\tN0\n' \
  "R900" "SealFixture.Strong" "$H_WEAK" > "$BROKEN"
BROKEN_BEFORE="$(sha256sum "$BROKEN" | cut -d' ' -f1)"
expect reject "does not verify" \
  "refuses to install a registry that does not verify, even with a good new row" \
  env CRRG_IMPORTS="$SEAL_IMPORTS" "$SCRIPT_DIR/crrg-register-candidate" \
     --registry "$BROKEN" --id R901 --decl SealFixture.Composed
if [ "$(sha256sum "$BROKEN" | cut -d' ' -f1)" = "$BROKEN_BEFORE" ]; then
  check true "  ...and left that registry byte-identical too"
else
  check false "  ...but MUTATED that registry"
fi


echo ""
echo "crrg-live-run (generic dispatch, Spec §16.6.1):"

# Fake adapters only. The point of these checks is that CRRG passes through
# EXACTLY the argv the downstream declared and substitutes exactly one
# instruction -- not that any real vendor CLI works, which is not CRRG's
# business and would couple this suite to three release cycles.
LR="$TMPDIR_SELFTEST/live"
mkdir -p "$LR"
for m in codex kimi claude; do
  printf '#!/usr/bin/env bash\nprintf "FAKE-%s"\nfor a in "$@"; do printf " |%%s|" "$a"; done\necho\n' "$m" \
    > "$LR/fake-$m"
  chmod +x "$LR/fake-$m"
done
printf '#!/usr/bin/env bash\necho PREFLIGHT-OK\n' > "$LR/preflight.sh"
chmod +x "$LR/preflight.sh"
printf 'candidate-id\tBANNED_ID\ndeclaration\tCRRG.Edge\nnamespace\tCRRG.CompositionDebt\n' \
  > "$LR/bans.tsv"

write_live_config() {  # $1 = path, $2 = kimi argv fragment
  cat > "$1" <<CFG
{
  "repo_root": "$CRRG_ROOT",
  "program": "Spec.md",
  "preflight": ["$LR/preflight.sh"],
  "gate": ["true"],
  "operator_bans": "$LR/bans.tsv",
  "models": {
    "codex":  ["$LR/fake-codex", "--full-auto", "{PROMPT}"],
    "kimi":   [$2],
    "claude": ["$LR/fake-claude", "--dangerously-skip-permissions", "{PROMPT}"]
  }
}
CFG
}
write_live_config "$LR/live.json" "\"$LR/fake-kimi\", \"--yolo\", \"{PROMPT}\""

PROMPT_LINE="Read Spec.md fully and start the experiment."

expect ok "FAKE-codex |--full-auto| |$PROMPT_LINE|" \
  "dispatches the Codex adapter with the downstream argv, verbatim" \
  "$SCRIPT_DIR/crrg-live-run" --config "$LR/live.json" --model codex

expect ok "FAKE-kimi |--yolo| |$PROMPT_LINE|" \
  "dispatches the Kimi adapter with the downstream argv, verbatim" \
  "$SCRIPT_DIR/crrg-live-run" --config "$LR/live.json" --model kimi

expect ok "FAKE-claude |--dangerously-skip-permissions| |$PROMPT_LINE|" \
  "dispatches the Claude adapter with the downstream argv, verbatim" \
  "$SCRIPT_DIR/crrg-live-run" --config "$LR/live.json" --model claude

# Model choice must be orchestration only. If any of these three could differ in
# the instruction they deliver, the launcher would be part of the trust story.
CODEX_P="$("$SCRIPT_DIR/crrg-live-run" --config "$LR/live.json" --model codex 2>&1 | grep -c "$PROMPT_LINE")"
KIMI_P="$("$SCRIPT_DIR/crrg-live-run" --config "$LR/live.json" --model kimi 2>&1 | grep -c "$PROMPT_LINE")"
if [ "$CODEX_P" -ge 1 ] && [ "$KIMI_P" -ge 1 ]; then
  check true "every adapter delivers the identical instruction; model choice is orchestration"
else
  check false "every adapter delivers the identical instruction; model choice is orchestration"
fi

write_live_config "$LR/noprompt.json" "\"$LR/fake-kimi\", \"--yolo\""
expect reject "contains no {PROMPT} token" \
  "rejects a model argv with no {PROMPT} token" \
  "$SCRIPT_DIR/crrg-live-run" --config "$LR/noprompt.json" --model kimi

write_live_config "$LR/dupprompt.json" "\"$LR/fake-kimi\", \"{PROMPT}\", \"{PROMPT}\""
expect reject "exactly one is required" \
  "rejects a model argv with two {PROMPT} tokens" \
  "$SCRIPT_DIR/crrg-live-run" --config "$LR/dupprompt.json" --model kimi

printf 'candidate-id\tX\nnot-a-kind\tY\n' > "$LR/bad-bans.tsv"
sed "s|$LR/bans.tsv|$LR/bad-bans.tsv|" "$LR/live.json" > "$LR/badban.json"
expect reject "malformed; refusing to launch" \
  "refuses to launch against a malformed operator ban file" \
  "$SCRIPT_DIR/crrg-live-run" --config "$LR/badban.json" --model codex

echo ""
echo "crrg-policy-check (operator exclusions, Spec §7):"

pol() { "$SCRIPT_DIR/crrg-policy-check" --bans "$LR/bans.tsv" "$@"; }

expect reject "candidate id 'BANNED_ID' is banned" \
  "a banned candidate id cannot be selected as live work" \
  pol --candidate BANNED_ID

expect ok "is not banned" \
  "an unbanned candidate id is selectable" \
  pol --candidate NOT_BANNED_ID

# The closure questions go through crrg-forbid. These assert the DELEGATION
# fired -- the forbid audit's own message -- not merely that the exit code was
# non-zero, which a typo in the ban file would also produce.
expect reject "FORBIDDEN CRRG.Edge" \
  "a banned declaration is rejected through crrg-forbid's dependency closure" \
  env CRRG_IMPORTS=CRRG "$SCRIPT_DIR/crrg-policy-check" \
      --bans "$LR/bans.tsv" --root CRRG.Edge.trans

expect ok "avoids all" \
  "a root that does not reach the banned declaration is accepted" \
  env CRRG_IMPORTS=CRRG "$SCRIPT_DIR/crrg-policy-check" \
      --bans "$LR/bans.tsv" --root CRRG.Goal.Proved

printf 'namespace\tCRRG.CompositionDebt\n' > "$LR/ns-only.tsv"
expect reject "FORBIDDEN" \
  "a banned namespace is rejected through crrg-forbid" \
  env CRRG_IMPORTS=CRRG "$SCRIPT_DIR/crrg-policy-check" \
      --bans "$LR/ns-only.tsv" --root CRRG.CompositionDebt.discharge

# A namespace-only policy must not reject everything. An earlier draft padded
# --forbid with a synthetic name to satisfy crrg-forbid's vacuity check; that
# name does not exist, so the misspelled-prohibition guard fired and the policy
# rejected every root. A policy tool failing closed on everything is as useless
# as one failing open, and quieter about it.
expect ok "avoids all" \
  "...and a namespace-only policy still accepts an unrelated root" \
  env CRRG_IMPORTS=CRRG "$SCRIPT_DIR/crrg-policy-check" \
      --bans "$LR/ns-only.tsv" --root CRRG.Edge.trans

printf '# only comments and blanks\n\n' > "$LR/empty-bans.tsv"
expect ok "nothing to enforce" \
  "an empty policy enforces nothing rather than running a vacuous audit" \
  env CRRG_IMPORTS=CRRG "$SCRIPT_DIR/crrg-policy-check" \
      --bans "$LR/empty-bans.tsv" --root CRRG.Edge.trans

expect reject "POLICY FILE MALFORMED" \
  "a malformed policy file fails rather than silently dropping the rule" \
  pol --bans "$LR/bad-bans.tsv" --validate

# Spec §7: a ban restricts selection. It is not a mathematical fact and must not
# behave like one. crrg-policy-check has no write path at all, which is the
# cheapest possible proof of that -- asserted here so a future edit that adds
# one is caught.
if grep -qE '^\s*(open\([^)]*["'"'"']w|Path\([^)]*\)\.write_text|shutil\.|os\.remove|os\.rename)' \
     "$SCRIPT_DIR/crrg-policy-check"; then
  check false "adding a ban cannot mutate graph state (policy tool has no write path)"
else
  check true "adding a ban cannot mutate graph state (policy tool has no write path)"
fi


echo ""
echo "crrg-depth-check (reduction depth, Spec §10):"

# §10 asks a deployment to classify its active state before it moves the graph.
# This validates that the classification was MADE AND WRITTEN DOWN; it does not
# judge whether it is correct, because that is a research judgement about
# mathematics and a script pretending to make it would be inventing an authority
# CRRG does not have. The required fields are the ones that cannot be filled in
# without having actually considered the question.
DC="$TMPDIR_SELFTEST/depth"
mkdir -p "$DC"
dcheck() { "$SCRIPT_DIR/crrg-depth-check" --file "$1"; }

printf 'REFINED\ndepth: OVERREDUCED\nancestor: L005\nlost-information: the residual-mass bound the child dropped\nfailed-mechanism: polynomial alignment below minimum distance\n' > "$DC/over.txt"
expect ok "depth record OK (OVERREDUCED)" \
  "accepts a complete OVERREDUCED record" dcheck "$DC/over.txt"

printf 'depth: OVERREDUCED\nlost-information: x\nfailed-mechanism: y\n' > "$DC/over-noanc.txt"
expect reject "missing: ancestor" \
  "rejects OVERREDUCED with no ancestor -- stepping up to nowhere is not a decision" \
  dcheck "$DC/over-noanc.txt"

printf 'depth: OVERREDUCED\nancestor: L005\nfailed-mechanism: y\n' > "$DC/over-nolost.txt"
expect reject "missing: lost-information" \
  "rejects OVERREDUCED with no lost-information" dcheck "$DC/over-nolost.txt"

printf 'depth: RIGHT-DEPTH\nmechanism: BCH bound at arity two\nfailure-class: no averaging argument in the corpus\n' > "$DC/right.txt"
expect ok "depth record OK (RIGHT-DEPTH)" \
  "accepts a complete RIGHT-DEPTH record" dcheck "$DC/right.txt"

printf 'depth: RIGHT-DEPTH\nfailure-class: y\n' > "$DC/right-nomech.txt"
expect reject "missing: mechanism" \
  "rejects RIGHT-DEPTH with no mechanism" dcheck "$DC/right-nomech.txt"

printf 'depth: UNDERREDUCED\nrefinement: Downstream.Attempts.E17_refinement\n' > "$DC/under.txt"
expect ok "depth record OK (UNDERREDUCED)" \
  "accepts a complete UNDERREDUCED record" dcheck "$DC/under.txt"

printf 'depth: UNDERREDUCED\n' > "$DC/under-noref.txt"
expect reject "missing: refinement" \
  "rejects UNDERREDUCED with no refinement declaration" dcheck "$DC/under-noref.txt"

printf 'depth: SHALLOW\nrefinement: x\n' > "$DC/badclass.txt"
expect reject "unknown depth class" \
  "rejects a depth class §10 does not define" dcheck "$DC/badclass.txt"

# A field present but blank is the shape of the judgement without the judgement,
# and is the easiest way to satisfy a naive presence check while deciding
# nothing.
printf 'depth: UNDERREDUCED\nrefinement:    \n' > "$DC/blank.txt"
expect reject "empty field(s)" \
  "rejects a required field that is present but blank" dcheck "$DC/blank.txt"

printf 'REFINED\nreason: it works\nstrategic-reason: it is better\n' > "$DC/nodepth.txt"
expect reject "no \`depth:\` line" \
  "rejects an outcome carrying no classification at all" dcheck "$DC/nodepth.txt"

printf 'depth: UNDERREDUCED\ndepth: RIGHT-DEPTH\nrefinement: x\nmechanism: y\nfailure-class: z\n' > "$DC/two.txt"
expect reject "exactly one classification is required" \
  "rejects two classifications -- two is no classification" dcheck "$DC/two.txt"

echo ""
echo "crrg-episode (research episodes and stall replay, Spec §22, §23):"

# The stall replay here is a MIRROR of CRRG/CRRG/Stall.lean, not a second
# opinion, so these cases are the enumerated Lean regressions run through the
# tool: five no-transitions block, a response clears, an admitted terminal
# resets, checkpoints and integrity events are inert.
EP="$SCRIPT_DIR/crrg-episode"
EPD="$TMPDIR_SELFTEST/episode"
mkdir -p "$EPD"

# Exit codes are part of this tool's contract (§19.2): a terminal no-transition
# has to be distinguishable from an admitted transition and from a rejection by
# exit code alone. A test that only asked "did it fail" would not notice a 10
# that had silently become a 30, which is the whole point of the four codes.
ep_code() { "$EP" "$@" >/dev/null 2>&1; echo "exit=$?"; }

# Five terminal no-transitions on one obligation under one mechanism.
seed_stall() {
  local log="$1" mech="$2" i
  printf '# CRRG episode log\n' > "$log"
  for i in 1 2 3 4 5; do
    "$EP" open "$log" "e$i" OBL-S "$mech" "gen-$i" >/dev/null 2>&1
    "$EP" terminal "$log" "e$i" noTransition >/dev/null 2>&1
  done
}

HAPPY="$EPD/happy.tsv"
printf '# CRRG episode log\n' > "$HAPPY"

expect ok "recorded: OPEN" \
  "opens an episode against one obligation and one mechanism" \
  "$EP" open "$HAPPY" e1 OBL-A mech-a gen-3 "first attempt"

expect ok "recorded: CHECKPOINT" \
  "records a checkpoint against the open episode" \
  "$EP" checkpoint "$HAPPY" e1 lemma-42 "helper theorem"

expect ok "exit=0" \
  "an admitted terminal closes the episode and exits 0" \
  ep_code terminal "$HAPPY" e1 admitted-refined

expect reject "episode 'e1' is closed" \
  "refuses a second terminal on a closed episode -- exactly one per episode" \
  "$EP" terminal "$HAPPY" e1 noTransition

# A rejected append must leave the file byte-identical, and asserting that is not
# the same as checking it. Added beyond the tasking's list for the same reason
# crrg-register-candidate carries the equivalent case: the property §2 requires
# is the one an append-only tool is most likely to break silently.
HAPPY_BEFORE="$(sha256sum "$HAPPY" | cut -d' ' -f1)"
"$EP" terminal "$HAPPY" e1 noTransition >/dev/null 2>&1
HAPPY_AFTER="$(sha256sum "$HAPPY" | cut -d' ' -f1)"
ep_untouched() {
  if [ "$HAPPY_BEFORE" = "$HAPPY_AFTER" ]; then echo "log byte-identical"
  else echo "LOG MUTATED ON A FAILING PATH"; fi
}
expect ok "log byte-identical" \
  "  ...and left the log byte-identical: rejected second terminal" ep_untouched

NT="$EPD/notransition.tsv"
printf '# CRRG episode log\n' > "$NT"
"$EP" open "$NT" n1 OBL-N mech-n gen-1 >/dev/null 2>&1
expect ok "exit=10" \
  "a terminal noTransition exits 10 -- valid, and not a certified transition (§19.2)" \
  ep_code terminal "$NT" n1 noTransition

expect reject "is not blocked" \
  "refuses a stall response on an obligation that is not blocked" \
  "$EP" respond "$NT" OBL-N reselect

STALL="$EPD/stall.tsv"
seed_stall "$STALL" mech-a

expect ok "no-transition-count: 5" \
  "counts five terminal no-transitions on one obligation" \
  "$EP" status "$STALL" OBL-S

expect ok "blocked: yes" \
  "the fifth no-transition blocks the obligation at threshold 5" \
  "$EP" status "$STALL" OBL-S

expect reject "stalled: response required" \
  "may-launch refuses a blocked obligation" \
  "$EP" may-launch "$STALL" OBL-S mech-a

expect ok "recorded: RESPONSE newMechanism" \
  "records a stall response against the blocked obligation" \
  "$EP" respond "$STALL" OBL-S newMechanism

expect ok "may-launch: allowed" \
  "may-launch allows a different mechanism once a response is recorded" \
  "$EP" may-launch "$STALL" OBL-S mech-b

# §22: immediate relaunch of the same stalled obligation under the same recorded
# mechanism is rejected. Immediate-only by design -- durable anti-circling is
# deferred research (§26 R2), not enforcement.
expect reject "same mechanism immediately after stall" \
  "may-launch still refuses the mechanism that stalled, after that response" \
  "$EP" may-launch "$STALL" OBL-S mech-a

OVR="$EPD/override.tsv"
seed_stall "$OVR" mech-a
expect ok "recorded: RESPONSE ownerOverride" \
  "records an owner override against the blocked obligation" \
  "$EP" respond "$OVR" OBL-S ownerOverride

expect ok "may-launch: allowed" \
  "an owner override permits the same mechanism -- explicit operator decision (§22)" \
  "$EP" may-launch "$OVR" OBL-S mech-a

# §23: a checkpoint is append-only evidence. It does not close the episode and
# does not touch the detector.
CPL="$EPD/checkpoints.tsv"
printf '# CRRG episode log\n' > "$CPL"
"$EP" open "$CPL" c1 OBL-C mech-c gen-1 >/dev/null 2>&1
for r in a b c d e f; do "$EP" checkpoint "$CPL" c1 "ref-$r" >/dev/null 2>&1; done
expect ok "no-transition-count: 0" \
  "six checkpoints do not increment the stall count" \
  "$EP" status "$CPL" OBL-C

CORRUPT="$EPD/corrupt.tsv"
cp "$CPL" "$CORRUPT"
printf 'OPEN\tbroken-row\n' >> "$CORRUPT"
expect reject "wrong column count" \
  "a corrupted row fails the next invocation loudly instead of being skipped" \
  "$EP" checkpoint "$CORRUPT" c1 ref-z


echo ""
echo "crrg-mechanism (mechanism records, Spec §24):"

MECH="$SCRIPT_DIR/crrg-mechanism"
MD="$TMPDIR_SELFTEST/mechanism"
mkdir -p "$MD"
MREG="$MD/registry.tsv"
printf '# CRRG mechanism registry\n' > "$MREG"

mech_fp_stable() {
  local a b
  a="$("$MECH" fingerprint "$MREG" mech-a 2>&1)"
  b="$("$MECH" fingerprint "$MREG" mech-a 2>&1)"
  if [ "$a" = "$b" ] && [ ${#a} -eq 64 ]; then echo "fingerprint stable: $a"
  else echo "FINGERPRINT UNSTABLE: $a vs $b"; fi
}

# A check that cannot run must never be reported as a check that passed. This is
# the quiet failure mode the whole self-test suite exists for, so the exit code
# is pinned exactly rather than merely required to be non-zero.
mech_unconfigured() {
  env -u CRRG_WORKDIR -u CRRG_IMPORTS \
    "$MECH" resolve-check "$MREG" mech-a 2>&1 | sed 's/^/    /'
  echo "unconfigured-exit=${PIPESTATUS[0]}"
}

expect ok "fingerprint:" \
  "registers a mechanism with a declared basis and prints its fingerprint" \
  "$MECH" register "$MREG" mech-a OBL-A route-7 CRRG.Edge.id,CRRG.Edge.trans - "first"

expect ok "fingerprint stable:" \
  "the fingerprint is deterministic across invocations" mech_fp_stable

expect reject "never silently mutated" \
  "refuses to re-register a mechanism id with different contents (§24)" \
  "$MECH" register "$MREG" mech-a OBL-A route-9 CRRG.Edge.id - "retarget"

expect ok "unconfigured-exit=30" \
  "resolve-check with no configured environment exits 30, never a silent pass" \
  mech_unconfigured


echo ""
echo "crrg-obligations (unique live obligations, Spec §21):"

OBLI="$SCRIPT_DIR/crrg-obligations"
OD="$TMPDIR_SELFTEST/obligations"
mkdir -p "$OD"

# Two candidate ids carrying one sealed proposition: the L016/L017 shape this
# view exists to catch. Identity is the seal hash, not the id.
{
  printf '# seal registry\n'
  printf 'L016\tD.left\thash-aaa\tc0\t2026-01-01T00:00:00Z\t-\tL016\t-\n'
  printf 'L017\tD.right\thash-aaa\tc0\t2026-01-01T00:00:00Z\t-\tL017\t-\n'
  printf 'L020\tD.other\thash-bbb\tc0\t2026-01-01T00:00:00Z\t-\tL020\t-\n'
} > "$OD/seals.tsv"
printf '# task map\np1\thash-aaa\np2\thash-aaa\np3\thash-bbb\n' > "$OD/tasks.tsv"

obl_deterministic() {
  local a b
  a="$("$OBLI" view "$OD/seals.tsv" "$OD/tasks.tsv" 2>&1)"
  b="$("$OBLI" view "$OD/seals.tsv" "$OD/tasks.tsv" 2>&1)"
  if [ "$a" = "$b" ]; then echo "view byte-identical across runs"
  else echo "VIEW NONDETERMINISTIC"; fi
}

expect ok "DUPLICATE" \
  "flags two positions carrying one sealed proposition as a single obligation" \
  "$OBLI" view "$OD/seals.tsv" "$OD/tasks.tsv"

expect ok "every task-map position resolves to a sealed obligation" \
  "accepts a task map whose hashes are all present in the registry" \
  "$OBLI" check "$OD/seals.tsv" "$OD/tasks.tsv"

expect ok "view byte-identical across runs" \
  "the view is deterministic -- same inputs, same bytes" obl_deterministic

printf 'p9\thash-zzz\n' >> "$OD/tasks.tsv"
expect reject "seal hash not present in the seal registry" \
  "rejects a task-map position whose obligation is not sealed" \
  "$OBLI" check "$OD/seals.tsv" "$OD/tasks.tsv"


echo ""
echo "crrg-evidence (novelty evidence substrate, Spec §25):"

# §25 records evidence and measures nothing. The cases below check the two
# mechanical classifications, that the optional novelty label feeds neither of
# them, and -- the point of the substrate -- that recording evidence cannot move
# certified or orchestration state.
EV="$SCRIPT_DIR/crrg-evidence"
EVD="$TMPDIR_SELFTEST/evidence"
mkdir -p "$EVD"

EVEP="$EVD/episodes.tsv"
printf '# CRRG episode log\n' > "$EVEP"
"$EP" open "$EVEP" v1 OBL-E mech-e gen-1 >/dev/null 2>&1
"$EP" terminal "$EVEP" v1 admitted-refined >/dev/null 2>&1
"$EP" open "$EVEP" v2 OBL-E mech-e gen-2 >/dev/null 2>&1
"$EP" terminal "$EVEP" v2 noTransition >/dev/null 2>&1

EVLOG="$EVD/evidence.tsv"
printf '# CRRG evidence log\n' > "$EVLOG"

ev_code() { "$EV" "$@" >/dev/null 2>&1; echo "exit=$?"; }

expect ok "recorded: evidence for CRRG.Helper.lemma" \
  "records evidence for a declaration against an existing episode" \
  "$EV" record "$EVLOG" "$EVEP" --decl CRRG.Helper.lemma --commit c0ffee \
  --episode v1 --type-fp tfp-1 --label CANDIDATE_NOVEL "a helper theorem"

# An unknown episode is this invocation's own precondition failing, so 20 --
# the same split ratified for crrg-episode respond in Phase D.
expect ok "exit=20" \
  "refuses evidence against an episode that is not in the episode log (exit 20)" \
  ev_code record "$EVLOG" "$EVEP" --decl CRRG.Ghost --commit c0ffee --episode v404

expect ok "NEW_DECLARATION" \
  "the first record of a (decl, type_fp) classifies NEW_DECLARATION" \
  "$EV" classify "$EVLOG" "$EVEP"

# Episode v1 terminated admitted-refined, so evidence recorded inside it was
# consumed by a certified transition; v2 terminated noTransition, so it was not.
expect ok "CONSUMED_BY_CERTIFIED_TRANSITION" \
  "evidence in an episode that terminated admitted-refined is CONSUMED" \
  "$EV" classify "$EVLOG" "$EVEP"

"$EV" record "$EVLOG" "$EVEP" --decl CRRG.Helper.lemma --commit c0ffee \
  --episode v2 --type-fp tfp-1 >/dev/null 2>&1
expect ok "EXISTING_DECLARATION" \
  "re-recording the same (decl, type_fp) classifies EXISTING_DECLARATION" \
  "$EV" classify "$EVLOG" "$EVEP"

expect ok "UNCONSUMED" \
  "evidence in an episode that terminated noTransition is UNCONSUMED" \
  "$EV" classify "$EVLOG" "$EVEP"

# The label is metadata (§25): stored, printed back, and computed from by
# nothing. Two logs identical except for the label column must classify
# identically once the label lines themselves are removed.
LBLA="$EVD/label-a.tsv"; LBLB="$EVD/label-b.tsv"
printf '# CRRG evidence log\n' > "$LBLA"
printf '# CRRG evidence log\n' > "$LBLB"
"$EV" record "$LBLA" "$EVEP" --decl CRRG.Same --commit c0ffee --episode v1 \
  --type-fp tfp-2 --label CANDIDATE_NOVEL >/dev/null 2>&1
"$EV" record "$LBLB" "$EVEP" --decl CRRG.Same --commit c0ffee --episode v1 \
  --type-fp tfp-2 --label KNOWN_OR_FORMALIZATION >/dev/null 2>&1
ev_label_inert() {
  local a b
  a="$("$EV" classify "$LBLA" "$EVEP" 2>&1 | grep -vE 'novelty-label:|evidence log')"
  b="$("$EV" classify "$LBLB" "$EVEP" 2>&1 | grep -vE 'novelty-label:|evidence log')"
  if [ "$a" = "$b" ]; then echo "classification independent of novelty label"
  else echo "LABEL CHANGED THE CLASSIFICATION"; fi
  "$EV" view "$LBLA" 2>&1 | grep -F 'novelty-label: CANDIDATE_NOVEL' >/dev/null \
    && echo "label stored and printed" || echo "LABEL NOT STORED"
}
expect ok "classification independent of novelty label" \
  "a novelty label is stored and printed but changes no classification (§25)" \
  ev_label_inert

expect ok "label stored and printed" \
  "  ...and the label is still recorded and shown by view" ev_label_inert

# THE ISOLATION PROPERTY. §25: evidence records cannot mutate the root, the
# frontier, candidate truth state, project reward, or the stall count. Here that
# is checked where it is checkable: after a sequence of evidence operations
# including a failing one, the episode log is byte-identical and the stall
# state crrg-episode reports is unchanged.
EV_EP_BEFORE="$(sha256sum "$EVEP" | cut -d' ' -f1)"
EV_ST_BEFORE="$("$EP" status "$EVEP" 2>&1)"
"$EV" record "$EVLOG" "$EVEP" --decl CRRG.More --commit c0ffee --episode v2 >/dev/null 2>&1
"$EV" classify "$EVLOG" "$EVEP" >/dev/null 2>&1
"$EV" view "$EVLOG" >/dev/null 2>&1
"$EV" validate "$EVLOG" "$EVEP" >/dev/null 2>&1
"$EV" record "$EVLOG" "$EVEP" --decl CRRG.Ghost --commit c0ffee --episode v404 >/dev/null 2>&1
EV_EP_AFTER="$(sha256sum "$EVEP" | cut -d' ' -f1)"
EV_ST_AFTER="$("$EP" status "$EVEP" 2>&1)"
ev_isolated() {
  if [ "$EV_EP_BEFORE" != "$EV_EP_AFTER" ]; then echo "EPISODE LOG MUTATED BY EVIDENCE"
  elif [ "$EV_ST_BEFORE" != "$EV_ST_AFTER" ]; then echo "STALL STATE MOVED BY EVIDENCE"
  else echo "episode log and stall state untouched by evidence"; fi
}
expect ok "episode log and stall state untouched by evidence" \
  "recording evidence moves no certified or orchestration state (§25)" ev_isolated

ev_deterministic() {
  local a b
  a="$("$EV" view "$EVLOG" 2>&1)"
  b="$("$EV" view "$EVLOG" 2>&1)"
  if [ "$a" = "$b" ]; then echo "view byte-identical across runs"
  else echo "VIEW NONDETERMINISTIC"; fi
}
expect ok "view byte-identical across runs" \
  "the evidence view is deterministic -- same input, same bytes" ev_deterministic

EVBAD="$EVD/corrupt.tsv"
cp "$EVLOG" "$EVBAD"
printf 'only\ttwo\n' >> "$EVBAD"
expect ok "exit=30" \
  "a corrupted evidence row fails the next invocation loudly (exit 30)" \
  ev_code validate "$EVBAD" "$EVEP"


echo ""
if [ "$fail" -ne 0 ]; then
  echo "=== CRRG gate self-tests FAILED ($fail of $((pass + fail))) ==="
  exit 1
fi
echo "=== CRRG gate self-tests PASSED ($pass checks) ==="
