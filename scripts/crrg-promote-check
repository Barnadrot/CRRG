#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CRRG_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

if [ $# -lt 2 ]; then
  echo "Usage: crrg-promote-check <theorem-name> <sealed-target-name>"
  echo "Example: crrg-promote-check MyProject.E17 MyProject.Candidates.E17Target"
  exit 1
fi

THEOREM="$1"
TARGET="$2"

cd "$CRRG_ROOT"

echo "=== Promotion check ==="
echo "Theorem: $THEOREM"
echo "Target:  $TARGET"
echo ""

TMPFILE="${CRRG_ROOT}/.crrg_promote_tmp_$$.lean"
trap 'rm -f "$TMPFILE"' EXIT

echo "[1/3] Verifying theorem exists..."
cat > "$TMPFILE" <<LEAN
import CRRG
#check @$THEOREM
LEAN
lake env lean "$TMPFILE"

echo ""
echo "[2/3] Verifying target declaration exists..."
cat > "$TMPFILE" <<LEAN
import CRRG
#check @$TARGET
LEAN
lake env lean "$TMPFILE"

echo ""
echo "[3/3] Type-link check (theorem inhabits sealed target)..."
cat > "$TMPFILE" <<LEAN
import CRRG
example : $TARGET := $THEOREM
LEAN
lake env lean "$TMPFILE"

echo ""
echo "=== Promotion check PASSED ==="
echo "The theorem inhabits the exact sealed target proposition."
echo "Proceed with candidate promotion to CERTIFIED status."
