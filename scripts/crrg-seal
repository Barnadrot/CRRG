#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CRRG_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

if [ $# -lt 1 ]; then
  echo "Usage: crrg-seal <candidate-declaration-name>"
  echo "Example: crrg-seal MyProject.Candidates.E17Target"
  exit 1
fi

DECL="$1"

cd "$CRRG_ROOT"

echo "=== Seal check for: $DECL ==="
echo ""
echo "Verifying declaration exists and printing its type..."

TMPFILE="${CRRG_ROOT}/.crrg_seal_tmp_$$.lean"
trap 'rm -f "$TMPFILE"' EXIT
cat > "$TMPFILE" <<LEAN
import CRRG
#check @$DECL
LEAN
lake env lean "$TMPFILE"

echo ""
echo "=== End seal check ==="
echo ""
echo "If the type above is the exact proposition you intend to seal,"
echo "record it as a SealedCandidate in the downstream graph adapter."
